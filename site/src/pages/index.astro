---
import Landing from "../layouts/Landing.astro";
import AddressMorph from "../components/landing/AddressMorph.astro";
import DitherGlobe from "../components/landing/DitherGlobe.astro";
import HalftoneField from "../components/landing/HalftoneField.astro";
import StreetMap from "../components/landing/StreetMap.astro";
import Benchmarks from "../components/landing/Benchmarks.astro";
import Compare from "../components/landing/Compare.astro";
import Faq from "../components/landing/Faq.astro";
import Walkthrough from "../components/landing/Walkthrough.astro";

// Public landmarks only, so no example points at someone's home, each in its own
// language and script. Coordinates are og's own answers on the planet Pack, so typing
// an example gives what it shows.
const examples: [string, string][] = [
  ["1600 Pennsylvania Ave NW, Washington", "38.89747, -77.03655"],
  ["名古屋城, 名古屋市", "35.18532, 136.89918"],
  ["Красная площадь, Москва", "55.75276, 37.62358"],
  ["इंडिया गेट, नई दिल्ली", "28.61293, 77.22949"],
  ["5 Av. Anatole France, Paris", "48.85882, 2.29460"],
  ["故宫博物院, 北京", "39.91743, 116.39078"],
  ["قلعة صلاح الدين, القاهرة", "30.02983, 31.26147"],
  ["불국사, 경주", "35.78909, 129.33182"],
  ["הכותל המערבי, ירושלים", "31.77640, 35.23308"],
  ["Cristo Redentor, Rio de Janeiro", "-22.95192, -43.21046"],
];

const features = [
  {
    title: "Self-hosted",
    text: "og runs on your own hardware. No address leaves your network, and there is no per\u2011lookup fee.",
    icon: "M4 4h16v6H4zM4 14h16v6H4zM8 7h.01M8 17h.01",
  },
  {
    title: "Fast",
    text: "A forward query takes 1.0\u00a0ms at the median on Ontario, against 11.5\u00a0ms for Pelias and 40.0\u00a0ms for Nominatim.",
    icon: "M13 2 4 14h7l-1 8 9-12h-7z",
  },
  {
    title: "Lightweight",
    text: "One binary and one file, with no database or search cluster to run. Ontario's Pack is 324\u00a0MB.",
    icon: "M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8zM14 3v5h5",
  },
];

const title = "OpenGeocode: free, open-source, self-hosted geocoding";
const description =
  "OpenGeocode is free, open-source geocoding you host yourself: forward, reverse, autocomplete and batch, offline, from one file built from OpenStreetMap and OpenAddresses.";
---

<Landing title={title} description={description}>
  <main class="og-hero">
    <section class="og-card">
      <HalftoneField />
      <StreetMap />
      <h1 class="sr-only">OpenGeocode: free, open-source, self-hosted geocoding</h1>
      <div class="og-copy" data-mode="examples">
        <button type="button" class="og-try">
          <span class="og-try-label">Try it for free</span>
          <span class="og-try-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </span>
        </button>
        <AddressMorph examples={examples} placeholder="100 Queen St W, Toronto" />
        <p class="og-result" aria-live="polite" hidden></p>
        <p class="og-sub">Fast, lightweight, self-hosted geocoding engine in pure Rust.</p>
        <a class="og-cta" href="/docs/quickstart/">Get started</a>
      </div>
      <div class="og-horizon">
        <DitherGlobe />
      </div>
    </section>
    <section class="og-features" aria-labelledby="og-features-title">
      <div class="og-features-head">
        <h2 id="og-features-title">630 million addresses in a single file.</h2>
        <p>Forward, reverse and batch geocoding built from OpenStreetMap and OpenAddresses, served from your own hardware.</p>
      </div>
      <div class="og-features-box">
        <span class="og-corner" aria-hidden="true"></span>
        <span class="og-corner" aria-hidden="true"></span>
        <span class="og-corner" aria-hidden="true"></span>
        <span class="og-corner" aria-hidden="true"></span>
        <ul class="og-features-grid">
          {features.map((f) => (
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={f.icon} /></svg>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
    <Benchmarks />
    <Walkthrough />
    <Compare />
    <Faq />
  </main>
  <script>
    // The pill or a click on the example starts typing in the headline.
    const copy = document.querySelector<HTMLElement>(".og-copy")!;
    const pill = copy.querySelector<HTMLButtonElement>(".og-try")!;
    const result = copy.querySelector<HTMLElement>(".og-result")!;
    const line = copy.querySelector("og-address-morph") as HTMLElement & {
      startEditing(): void;
      stopEditing(): void;
    };
    // Decoration only: if either failed to load, its methods are missing and the calls
    // below are skipped, so search itself never depends on them.
    const globe = document.querySelector("og-dither-globe") as HTMLElement & {
      turnTo?(lat: number, lon: number): void;
      release?(): void;
    };
    const map = document.querySelector("og-street-map") as HTMLElement & {
      show?(lat: number, lon: number): void;
      hide?(): void;
    };

    const setEditing = (editing: boolean) => {
      copy.dataset.mode = editing ? "edit" : "examples";
      result.hidden = true;
      if (editing) line.startEditing();
      else {
        line.stopEditing();
        globe.release?.();
        map.hide?.();
      }
    };

    pill.addEventListener("click", () => setEditing(true));
    copy.addEventListener("og-edit", () => setEditing(true));
    copy.addEventListener("og-cancel", () => setEditing(false));
    copy.addEventListener("og-clear", () => {
      result.hidden = true;
      globe.release?.();
      map.hide?.();
    });
    copy.addEventListener("input", () => (result.hidden = true));
    // The matched address goes under the coordinates, so a near miss is visible.
    copy.addEventListener("og-result", (event) => {
      const hit = (event as CustomEvent<{ label: string; coordinates: string } | null | undefined>).detail;
      result.hidden = false;
      if (hit) {
        const [lat, lon] = hit.coordinates.split(",").map(Number);
        globe.turnTo?.(lat, lon);
        map.show?.(lat, lon);
      } else {
        globe.release?.();
        map.hide?.();
      }
      result.textContent = result.title = hit
        ? hit.label
        : hit === null
          ? "No match for that address."
          : "Search isn't reachable right now. Try one of the example addresses.";
    });
  </script>
</Landing>
