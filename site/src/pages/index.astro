---
import Landing from "../layouts/Landing.astro";
import AddressMorph from "../components/landing/AddressMorph.astro";
import DitherGlobe from "../components/landing/DitherGlobe.astro";
import HalftoneField from "../components/landing/HalftoneField.astro";
import StreetMap from "../components/landing/StreetMap.astro";
import Benchmarks from "../components/landing/Benchmarks.astro";
import Compare from "../components/landing/Compare.astro";
import Faq from "../components/landing/Faq.astro";
import Walkthrough from "../components/landing/Walkthrough.astro";
import Corners from "../components/landing/Corners.astro";
import Disc from "../components/landing/Disc.astro";
import Button from "../components/ui/Button.astro";
import Icon, { type IconName } from "../components/ui/Icon.astro";

// The street addresses of public landmarks, so no example points at someone's
// home, each in its own language and script. Coordinates are og's own /geocode
// answers on the planet Pack, so typing an example gives what it shows.
const examples: [string, string][] = [
  ["1600 Pennsylvania Ave NW, Washington, DC", "38.89747, -77.03655"],
  ["大阪市中央区大阪城1-1", "34.68737, 135.52586"],
  ["Красная площадь, 3, Москва", "55.75470, 37.62144"],
  ["1 شارع الشيخ محمد بن راشد، دبي", "25.19721, 55.27416"],
  ["5 Av. Anatole France, Paris", "48.85826, 2.29450"],
  ["北京市东城区景山前街4号", "39.91743, 116.39078"],
  ["불국로 385, 경주", "35.79015, 129.33206"],
  ["רחוב רוטשילד 16, תל אביב", "32.06280, 34.77093"],
  ["Διονυσίου Αρεοπαγίτου 15, Αθήνα", "37.96847, 23.72848"],
  ["Av. Atlântica 1702, Rio de Janeiro", "-22.96701, -43.17919"],
];

const features: { title: string; text: string; icon: IconName }[] = [
  {
    title: "Self-hosted",
    text: "og runs on your own hardware. No address leaves your network, and there is no per\u2011lookup fee.",
    icon: "server",
  },
  {
    title: "Fast",
    text: "0.72\u00a0ms a query and 14,087 queries a second on the Netherlands: 6× Photon and Pelias.",
    icon: "zap",
  },
  {
    title: "Lightweight",
    text: "One binary, one file, no database. The whole Netherlands fits in 337\u00a0MB.",
    icon: "file",
  },
];

const title = "OpenGeocode: free, open-source, self-hosted geocoding";
const description =
  "OpenGeocode is free, open-source geocoding you host yourself: forward, reverse, autocomplete and batch, offline, from one file built from OpenStreetMap and OpenAddresses.";
---

<Landing title={title} description={description}>
  <main class="og-hero">
    <section class="og-card">
      <HalftoneField />
      <StreetMap />
      <h1 class="sr-only">OpenGeocode: free, open-source, self-hosted geocoding</h1>
      <div class="og-copy" data-mode="examples">
        <span class="og-try">
          <Button variant="raised" size="lg">
            Try it for free
            <Disc icon="arrow-right" edge="end" />
          </Button>
        </span>
        <AddressMorph examples={examples} placeholder="100 Queen St W, Toronto" />
        <p class="og-result" dir="auto" aria-live="polite" hidden></p>
        <p class="og-sub">Fast, lightweight, self-hosted geocoding engine in pure Rust.</p>
        <span class="og-cta">
          <Button variant="raised-solid" size="xl" href="/docs/quickstart/">Get started</Button>
        </span>
      </div>
      <div class="og-horizon">
        <DitherGlobe />
      </div>
    </section>
    <section class="og-features" aria-labelledby="og-features-title">
      <div class="og-features-head">
        <h2 id="og-features-title">640 million addresses in a single file.</h2>
        <p>Forward, reverse and batch geocoding built from OpenStreetMap and OpenAddresses, served from your own hardware.</p>
      </div>
      <div class="og-features-box">
        <Corners />
        <ul class="og-features-grid">
          {features.map((f) => (
            <li>
              <Icon name={f.icon} size="xl" />
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
    <Benchmarks />
    <Walkthrough />
    <Compare />
    <Faq />
  </main>
  <script>
    // The pill or a click on the example starts typing in the headline.
    const copy = document.querySelector<HTMLElement>(".og-copy")!;
    const pill = copy.querySelector<HTMLButtonElement>(".og-try button")!;
    const result = copy.querySelector<HTMLElement>(".og-result")!;
    const line = copy.querySelector("og-address-morph") as HTMLElement & {
      startEditing(): void;
      stopEditing(): void;
    };
    // Decoration only: if either failed to load, its methods are missing and the calls
    // below are skipped, so search itself never depends on them.
    const globe = document.querySelector("og-dither-globe") as HTMLElement & {
      turnTo?(lat: number, lon: number): void;
      release?(): void;
    };
    const map = document.querySelector("og-street-map") as HTMLElement & {
      show?(lat: number, lon: number): void;
      hide?(): void;
    };

    // While typing, the result's line says what to type; the answer replaces it.
    const hint = () => {
      result.hidden = false;
      result.dataset.hint = "";
      result.textContent = "Type a street address, anywhere in the world.";
      result.title = "";
    };

    const setEditing = (editing: boolean) => {
      copy.dataset.mode = editing ? "edit" : "examples";
      result.hidden = true;
      if (editing) {
        line.startEditing();
        hint();
      }
      else {
        line.stopEditing();
        globe.release?.();
        map.hide?.();
      }
    };

    pill.addEventListener("click", () => setEditing(true));
    copy.addEventListener("og-edit", () => setEditing(true));
    copy.addEventListener("og-cancel", () => setEditing(false));
    copy.addEventListener("og-clear", () => {
      hint();
      globe.release?.();
      map.hide?.();
    });
    copy.addEventListener("input", () => {
      if (!("hint" in result.dataset)) hint();
    });
    // The matched address goes under the coordinates, so a near miss is visible.
    copy.addEventListener("og-result", (event) => {
      const hit = (event as CustomEvent<{ label: string; coordinates: string } | null | undefined>).detail;
      result.hidden = false;
      delete result.dataset.hint;
      if (hit) {
        const [lat, lon] = hit.coordinates.split(",").map(Number);
        globe.turnTo?.(lat, lon);
        map.show?.(lat, lon);
      } else {
        globe.release?.();
        map.hide?.();
      }
      result.textContent = result.title = hit
        ? hit.label
        : hit === null
          ? "No match for that address."
          : "Search isn't reachable right now. Try one of the example addresses.";
    });
  </script>
</Landing>

<style>
  .og-hero {
    padding: var(--space-2);
  }

  /* The hero card holds the halftone and the street map behind the copy, and the globe's horizon cut off by the card's
     bottom edge. */
  .og-card {
    background-color: var(--color-background);
    border: var(--border) solid var(--color-border);
    border-radius: var(--radius-xl);
    color: var(--color-foreground);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 1fr auto;
    isolation: isolate;
    margin-inline: auto;
    max-inline-size: var(--layout-page-max);
    min-block-size: var(--layout-hero);
    overflow: hidden;
    position: relative;
  }

  /* Copy centred in the space above the horizon, so the gaps above and below it stay equal. */
  .og-copy {
    align-items: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-12) var(--space-6);
  }

  .og-try {
    margin-block-end: var(--space-10);
  }

  /* Hidden, not removed, so the headline holds its place while typing. */
  .og-copy[data-mode="edit"] .og-try {
    visibility: hidden;
  }

  /* One line between the headline and the subtitle, as tall as a body line. A longer match is cut short, and the full
     text is its title. */
  .og-result {
    block-size: var(--space-6);
    color: var(--color-foreground-secondary);
    font: var(--type-code);
    margin: var(--space-2) 0 0;
    max-inline-size: 100%;
    overflow: hidden;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The hint says what to type. It is not an answer, so it is quieter. */
  .og-result[data-hint] {
    color: var(--color-foreground-muted);
    font: var(--type-ui);
  }

  /* Hidden but still in place, so a result appearing never moves the page. */
  .og-result[hidden] {
    display: block;
    visibility: hidden;
  }

  .og-sub {
    color: var(--color-foreground-muted);
    font: var(--type-lead);
    letter-spacing: var(--tracking-snug);
    margin: var(--space-4) 0 0;
    text-align: center;
  }

  .og-cta {
    margin-block-start: var(--space-14);
  }

  /* The horizon is a fixed slice at the bottom of the card. The globe inside is wider than most screens and runs past
     the card's bottom edge, which cuts it off. */
  .og-horizon {
    block-size: var(--layout-horizon);
    display: flex;
    justify-content: center;
  }

  /* A column framed by dashed lines that end at the feature grid, whose border has a small square on each corner. */
  .og-features {
    background-color: var(--color-background);
    border-inline: var(--border) dashed var(--color-border);
    margin: 0 auto var(--space-16);
    max-inline-size: var(--layout-content-wide);
    padding-block-start: var(--space-16);
  }

  .og-features-head {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: 0 var(--space-6) var(--space-16);
    text-align: center;
  }

  .og-features-head h2 {
    font: var(--type-h1);
    letter-spacing: var(--tracking-tight);
    margin: 0;
    text-wrap: balance;
  }

  .og-features-head p {
    color: var(--color-foreground-secondary);
    font: var(--type-body);
    margin: 0;
    text-wrap: balance;
  }

  .og-features-box {
    background-color: var(--color-background);
    border-block: var(--border) solid var(--color-border);
    position: relative;
  }

  .og-features-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .og-features-grid li {
    align-items: flex-start;
    border-inline: var(--border) solid var(--color-border);
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
  }

  .og-features-grid li + li {
    border-block-start: var(--border) solid var(--color-border);
  }

  .og-features-grid h3 {
    font: var(--type-body-strong);
    letter-spacing: var(--tracking-tight);
    margin: var(--space-4) 0 var(--space-1);
  }

  .og-features-grid p {
    color: var(--color-foreground-muted);
    font: var(--type-body-sm);
    margin: 0;
  }

  @media (min-width: 52rem) {
    .og-features {
      margin-block-end: var(--space-24);
      padding-block-start: var(--space-24);
    }

    .og-features-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
    }

    .og-features-grid li + li {
      border-block-start: 0;
      border-inline-start: 0;
    }
  }
</style>
