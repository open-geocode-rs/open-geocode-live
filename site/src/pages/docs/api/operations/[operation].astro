---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import Operation from "../../../../components/api/Operation.astro";
import { allOperations } from "../../../../lib/openapi";

export const getStaticPaths = (() =>
  allOperations().map((operation) => ({ params: { operation: operation.slug }, props: { operation } }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { operation } = Astro.props;
---

{/* The right column holds the request example, so the page has no contents column and no pager. */}
<StarlightPage frontmatter={{ title: operation.title, tableOfContents: false, prev: false, next: false }}>
  <Operation {operation} />
</StarlightPage>
