---
import { Font } from "astro:assets";
import "../styles/tokens/primitives.css";
import "../styles/tokens/roles.css";
import "../styles/tokens/components.css";
import "../styles/tokens/host.css";
import ComponentGrid from "../components/system/ComponentGrid.astro";
import Foundations from "../components/system/Foundations.astro";
import { groupList, tokens } from "../components/system/tokens";

const themes = ["light", "dark"] as const;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Design system · OpenGeocode</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="96x96" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
  </head>
  <body class="system">
    <header class="system-header">
      <h1 class="system-title">Design system</h1>
      <p class="system-lead">
        Every token in the four token files, {tokens.length} in all, and every component in every variant, size and state. The page is
        rendered twice, light and dark.
      </p>
      <ul class="system-budget">
        {
          groupList.map((g) => (
            <li class="system-count" data-match={g.tokens.length === g.count ? "" : undefined}>
              <code>{g.name}</code> {g.tokens.length} of {g.count}
            </li>
          ))
        }
      </ul>
    </header>
    <div class="system-halves">
      {
        themes.map((theme) => (
          <main class="system-half" data-theme={theme}>
            <h2 class="system-theme">{theme === "light" ? "Light" : "Dark"}</h2>
            <Foundations theme={theme} />
            <ComponentGrid theme={theme} />
          </main>
        ))
      }
    </div>
  </body>
</html>

<style>
  .system {
    background-color: var(--color-background);
    color: var(--color-foreground);
    font: var(--type-body);
    margin: 0;
  }

  .system-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-12) var(--layout-gutter) var(--space-8);
  }

  .system-title {
    font: var(--type-h1);
    margin: 0;
  }

  .system-lead {
    color: var(--color-foreground-secondary);
    font: var(--type-lead);
    margin: 0;
    max-inline-size: var(--layout-content);
  }

  .system-budget {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .system-count {
    color: var(--color-danger);
    font: var(--type-caption);
  }

  .system-count[data-match] {
    color: var(--color-foreground-muted);
  }

  .system-halves {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--container-lg)), 1fr));
  }

  .system-half {
    background-color: var(--color-background);
    color: var(--color-foreground);
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    min-inline-size: 0;
    padding: var(--space-8) var(--space-4);
  }

  .system-theme {
    font: var(--type-h2);
    margin: 0;
  }

  @media (min-width: 40rem) {
    .system-half {
      padding: var(--space-12) var(--space-8);
    }
  }
</style>
