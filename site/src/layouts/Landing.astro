---
import { Font } from "astro:assets";
import "../styles/tokens/primitives.css";
import "../styles/tokens/roles.css";
import "../styles/tokens/components.css";
import Footer from "../components/landing/Footer.astro";
import SiteHeader from "../components/landing/SiteHeader.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const home = new URL("/", Astro.site).href;
// Pages build as directories, so the canonical form ends in a slash, as the sitemap's do.
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, "/"), Astro.site).href;
// Link previews need an absolute image URL; a relative one leaves the card blank.
const card = new URL("/og.png", Astro.site).href;
const cardAlt = "OpenGeocode logo: fast, lightweight, self-hosted geocoding engine in pure Rust.";
const repo = "https://github.com/open-geocode-rs/open-geocode";
// Every spelling people use, so search engines and AI models treat them as one thing.
const names = { name: "OpenGeocode", alternateName: ["Open Geocode", "open-geocode", "og"] };

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${home}#website`, url: home, ...names },
    {
      "@type": "Organization",
      "@id": `${home}#org`,
      ...names,
      url: home,
      logo: new URL("/apple-touch-icon.png", Astro.site).href,
      sameAs: [repo],
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${home}#software`,
      ...names,
      description:
        "Free, open-source, self-hosted geocoding in pure Rust: forward, autocomplete, reverse and batch, offline, from one file built from OpenStreetMap and OpenAddresses.",
      url: home,
      image: card,
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Linux, macOS, Windows",
      license: "https://opensource.org/license/mit",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      publisher: { "@id": `${home}#org` },
      sameAs: [repo, "https://crates.io/crates/open-geocode"],
    },
  ],
};
---

<!doctype html>
<!-- The landing page is always light. -->
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OpenGeocode" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={card} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={cardAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="icon" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
  </head>
  <body class="landing">
    <!-- A 12px dot grid behind the page. The header, cards and boxes sit on the plain page colour over it, so the dots
         show only in the margins. -->
    <svg class="landing-dots" aria-hidden="true">
      <defs>
        <pattern id="landing-dots" width="12" height="12" patternUnits="userSpaceOnUse">
          <circle cx="6" cy="6" r="1"></circle>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#landing-dots)"></rect>
    </svg>
    <SiteHeader />
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
  }

  .landing {
    -webkit-font-smoothing: antialiased;
    background-color: var(--color-background);
    color: var(--color-foreground);
    font: var(--type-body);
    min-block-size: 100vh;
    position: relative;
  }

  .landing ::selection {
    background-color: var(--color-accent-subtle);
    color: var(--color-foreground);
  }

  .landing-dots {
    block-size: 100%;
    fill: var(--color-border);
    inline-size: 100%;
    inset: 0;
    pointer-events: none;
    position: absolute;
    z-index: calc(var(--z-raised) * -1);
  }

  /* Read aloud, never seen. */
  .sr-only {
    block-size: var(--space-0-5);
    border: 0;
    clip: rect(0 0 0 0);
    inline-size: var(--space-0-5);
    margin: 0;
    overflow: hidden;
    padding: 0;
    position: absolute;
    white-space: nowrap;
  }
</style>
