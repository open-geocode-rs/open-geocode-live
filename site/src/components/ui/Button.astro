---
import type { HTMLAttributes } from "astro/types";
import Icon, { type IconName } from "./Icon.astro";

export const buttonVariants = ["solid", "outline", "ghost", "raised", "raised-solid"] as const;
export const buttonSizes = ["sm", "md", "lg"] as const;
export const buttonStates = ["rest", "hover", "focus", "pressed", "disabled"] as const;

type Base = Omit<HTMLAttributes<"button">, "class" | "class:list" | "style" | "aria-label"> & {
  variant?: (typeof buttonVariants)[number];
  size?: (typeof buttonSizes)[number];
  /** Holds a state without a pointer, for the system page. */
  state?: (typeof buttonStates)[number];
  icon?: IconName;
  /** Renders a link that looks like the button, for an action that goes to another page. */
  href?: string;
};

export type Props =
  | (Base & { iconOnly?: false; label?: string })
  | (Base & { iconOnly: true; icon: IconName; label: string });

const {
  variant = "solid",
  size = "md",
  state = "rest",
  icon,
  iconOnly = false,
  label,
  type = "button",
  disabled,
  href,
  ...attrs
} = Astro.props;

// No class from the caller reaches the element, not even the scope class the compiler passes, so no caller can restyle it.
const own = (attrs: Record<string, unknown>) => Object.fromEntries(Object.entries(attrs).filter(([key]) => key !== "class"));
// An icon-only button's icon carries its whole meaning, so from the default size up it takes the large icon.
const iconSize = size === "sm" ? "sm" : iconOnly ? "lg" : "md";
const Tag = href ? "a" : "button";
---

<Tag
  {...own(attrs)}
  class="button"
  href={href}
  type={href ? undefined : type}
  data-variant={variant}
  data-size={size}
  data-icon-only={iconOnly ? "" : undefined}
  data-state={state === "rest" ? undefined : state}
  disabled={href ? undefined : disabled || state === "disabled"}
  aria-label={iconOnly ? label : undefined}
>
  {
    icon && (
      <span class="button-icon">
        <Icon name={icon} size={iconSize} />
      </span>
    )
  }
  {!iconOnly && <slot />}
</Tag>

<style>
  .button {
    align-items: center;
    background-color: transparent;
    border: var(--border) solid transparent;
    border-radius: var(--radius-md);
    color: var(--color-foreground);
    cursor: pointer;
    display: inline-flex;
    font: var(--type-ui-strong);
    gap: var(--space-2);
    justify-content: center;
    padding-block: 0;
    text-decoration: none;
    transition-duration: var(--duration-hover);
    transition-property: background-color, border-color, color;
    transition-timing-function: var(--ease-hover);
    user-select: none;
    white-space: nowrap;
  }

  .button-icon {
    display: inline-flex;
  }

  .button[data-size="sm"] {
    block-size: var(--control-sm);
    padding-inline: var(--space-2);
  }

  .button[data-size="md"] {
    block-size: var(--control-md);
    padding-inline: var(--space-3);
  }

  .button[data-size="lg"] {
    block-size: var(--control-lg);
    padding-inline: var(--space-5);
  }

  .button[data-icon-only][data-size="sm"] {
    inline-size: var(--control-sm);
    padding-inline: 0;
  }

  .button[data-icon-only][data-size="md"] {
    inline-size: var(--control-md);
    padding-inline: 0;
  }

  .button[data-icon-only][data-size="lg"] {
    inline-size: var(--control-lg);
    padding-inline: 0;
  }

  .button[data-variant="solid"] {
    background-color: var(--color-solid);
    color: var(--color-on-solid);
  }

  .button[data-variant="outline"] {
    background-color: var(--color-control);
    border-color: var(--color-border-strong);
  }

  .button[data-variant="raised"] {
    background: var(--button-raised-cap);
    border: var(--border-strong) solid var(--button-raised-edge);
    border-radius: var(--radius-full);
    box-shadow: var(--button-raised-shadow);
  }

  .button[data-variant="raised-solid"] {
    background: var(--button-raised-solid-cap);
    border: var(--border-strong) solid var(--button-raised-solid-edge);
    border-radius: var(--radius-full);
    box-shadow: var(--button-raised-solid-shadow);
    color: var(--color-on-solid);
  }

  @media (hover: hover) and (pointer: fine) {
    .button[data-variant="solid"]:hover {
      background-color: var(--color-solid-hover);
    }

    .button[data-variant="outline"]:hover,
    .button[data-variant="ghost"]:hover {
      background-color: var(--color-control-hover);
    }

    .button[data-variant="raised"]:hover {
      background: var(--button-raised-cap-hover);
    }

    .button[data-variant="raised-solid"]:hover {
      background: var(--button-raised-solid-cap-hover);
    }
  }

  .button[data-variant="solid"][data-state="hover"] {
    background-color: var(--color-solid-hover);
  }

  .button[data-variant="outline"][data-state="hover"],
  .button[data-variant="ghost"][data-state="hover"] {
    background-color: var(--color-control-hover);
  }

  .button[data-variant="raised"][data-state="hover"] {
    background: var(--button-raised-cap-hover);
  }

  .button[data-variant="raised-solid"][data-state="hover"] {
    background: var(--button-raised-solid-cap-hover);
  }

  .button:focus-visible,
  .button[data-state="focus"] {
    outline: var(--border-strong) solid var(--color-focus);
    outline-offset: var(--space-0-5);
  }

  .button:disabled,
  .button[data-state="disabled"] {
    cursor: not-allowed;
    opacity: var(--opacity-disabled);
  }

  @media (prefers-reduced-motion: no-preference) {
    .button {
      transition:
        background-color var(--duration-hover) var(--ease-hover),
        border-color var(--duration-hover) var(--ease-hover),
        color var(--duration-hover) var(--ease-hover),
        box-shadow var(--duration-press) var(--ease-out),
        transform var(--duration-press) var(--ease-out),
        translate var(--duration-press) var(--ease-out);
    }

    .button:active,
    .button[data-state="pressed"] {
      transform: scale(var(--scale-press));
    }

    .button[data-variant="raised"]:active,
    .button[data-variant="raised"][data-state="pressed"] {
      box-shadow: var(--button-raised-shadow-pressed);
      translate: 0 var(--space-1);
    }

    .button[data-variant="raised-solid"]:active,
    .button[data-variant="raised-solid"][data-state="pressed"] {
      box-shadow: var(--button-raised-solid-shadow-pressed);
      translate: 0 var(--space-1);
    }
  }
</style>
