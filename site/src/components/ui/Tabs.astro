---
import Icon, { type IconName } from "./Icon.astro";

export const tabsVariants = ["default", "underline", "code"] as const;
export const tabsSizes = ["md"] as const;
export const tabsStates = ["rest", "hover", "focus", "current"] as const;

export interface Tab {
  id: string;
  label: string;
  icon?: IconName;
  /** Holds a state without a pointer, for the system page. Current comes from the tabs' own `current`. */
  state?: "rest" | "hover" | "focus";
}

export interface Props {
  /** Prefix for the ids of the tabs and panels, unique on the page. */
  id: string;
  /** Names the tab list for assistive technology. */
  label: string;
  tabs: Tab[];
  /** The id of the tab shown first. Defaults to the first tab. */
  current?: string;
  variant?: (typeof tabsVariants)[number];
  sharedPanel?: string;
}

const { id: uid, label, tabs, current = tabs[0]?.id, variant = "default", sharedPanel } = Astro.props;
const panels = sharedPanel ? [] : await Promise.all(tabs.map(async (t) => [t.id, await Astro.slots.render(t.id)] as const));
---

<div class:list={["tabs", { "code-frame": variant === "code" && !sharedPanel }]} data-tabs data-variant={variant} data-shared-panel={sharedPanel ? "" : undefined}>
  {/* Variant stays on the list and tabs so styling does not reach nested tab sets. */}
  <div class="tabs-list" role="tablist" aria-label={label} data-variant={variant}>
    {
      tabs.map((t) => (
        <button
          type="button"
          class="tabs-tab"
          role="tab"
          id={`${uid}-tab-${t.id}`}
          aria-controls={sharedPanel ?? `${uid}-panel-${t.id}`}
          aria-selected={t.id === current ? "true" : "false"}
          tabindex={t.id === current ? 0 : -1}
          data-tab-value={sharedPanel ? t.id : undefined}
          data-state={t.state && t.state !== "rest" ? t.state : undefined}
          data-variant={variant}
        >
          {t.icon && <Icon name={t.icon} size={variant === "code" ? "md" : "sm"} />}
          {t.label}
        </button>
      ))
    }
  </div>
  {Astro.slots.has("actions") && <div class="tabs-actions"><slot name="actions" /></div>}
  {
    panels.map(([id, html]) => (
      <div
        class="tabs-panel"
        role="tabpanel"
        id={`${uid}-panel-${id}`}
        aria-labelledby={`${uid}-tab-${id}`}
        hidden={id !== current}
        inert={id !== current}
        set:html={html}
      />
    ))
  }
</div>

<script>
  // A panel may hold tabs of its own, so each set of tabs touches only the tabs whose nearest set it is.
  const owns = (root: HTMLElement, tab: Element | null) => !!tab && tab.closest("[data-tabs]") === root;
  const tabsOf = (root: HTMLElement) => [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')].filter((t) => owns(root, t));

  function select(root: HTMLElement, tab: HTMLButtonElement, focus: boolean) {
    const shared = root.hasAttribute("data-shared-panel");
    const changed = tab.getAttribute("aria-selected") !== "true";
    for (const t of tabsOf(root)) {
      const on = t === tab;
      t.setAttribute("aria-selected", String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(t.getAttribute("aria-controls") ?? "");
      if (panel && !shared) {
        panel.hidden = !on;
        panel.inert = !on;
      }
    }
    if (shared) {
      document.getElementById(tab.getAttribute("aria-controls") ?? "")?.setAttribute("aria-labelledby", tab.id);
      if (changed) root.dispatchEvent(new Event("tab-change"));
    }
    if (focus) tab.focus();
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-tabs]")) {
    const tabs = tabsOf(root);
    root.addEventListener("click", (event) => {
      const tab = (event.target as Element).closest<HTMLButtonElement>('[role="tab"]');
      if (tab && owns(root, tab)) select(root, tab, false);
    });
    root.addEventListener("keydown", (event) => {
      const index = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (index === -1) return;
      const last = tabs.length - 1;
      const next =
        event.key === "ArrowRight" ? (index === last ? 0 : index + 1)
        : event.key === "ArrowLeft" ? (index === 0 ? last : index - 1)
        : event.key === "Home" ? 0
        : event.key === "End" ? last
        : -1;
      if (next === -1) return;
      event.preventDefault();
      select(root, tabs[next], true);
    });
  }
</script>

<style>
  /* Every panel sits in the one cell under the list, so the tabs are as tall as the tallest panel
     and choosing a tab never moves what follows. */
  .tabs {
    display: grid;
    gap: var(--space-4);
    grid-template-areas: "list" "panel";
    grid-template-columns: minmax(0, 1fr);
  }

  .tabs-panel {
    grid-area: panel;
    min-inline-size: 0;
  }

  /* A hidden panel keeps its place, so it still sizes the cell. A child may set its own visibility, so the panel is
     also made fully transparent, which no child can undo, and inert, so nothing in it takes a pointer or the focus. */
  .tabs-panel[hidden] {
    display: block;
    opacity: 0;
    visibility: hidden;
  }

  .tabs-list {
    grid-area: list;
    border-block-end: var(--border) solid var(--color-border);
    display: flex;
    gap: var(--space-1);
  }

  .tabs-tab {
    align-items: center;
    background-color: transparent;
    block-size: var(--control-md);
    border: 0;
    border-block-end: var(--border-strong) solid transparent;
    border-start-end-radius: var(--radius-md);
    border-start-start-radius: var(--radius-md);
    color: var(--color-foreground-muted);
    cursor: pointer;
    display: inline-flex;
    font: var(--type-ui-strong);
    gap: var(--space-1);
    padding-inline: var(--space-3);
  }

  @media (hover: hover) and (pointer: fine) {
    .tabs-tab:hover {
      background-color: var(--color-control);
      color: var(--color-foreground);
    }
  }

  .tabs-tab[data-state="hover"] {
    background-color: var(--color-control);
    color: var(--color-foreground);
  }

  .tabs-tab:focus-visible,
  .tabs-tab[data-state="focus"] {
    outline: var(--border-strong) solid var(--color-focus);
    outline-offset: var(--space-0-5);
  }

  .tabs-tab[aria-selected="true"] {
    border-block-end-color: var(--color-foreground);
    color: var(--color-foreground);
  }

  /* The current tab's mark lies on the list's rule, so the rule runs on under it. */
  .tabs-list[data-variant="underline"] {
    border-block-end: var(--border-strong) solid var(--color-border-control);
    gap: 0;
  }

  .tabs-tab[data-variant="underline"] {
    block-size: auto;
    border-radius: 0;
    font: var(--type-tab);
    margin-block-end: calc(var(--space-0-5) * -1);
    padding: var(--space-1) var(--space-5);
  }

  .tabs-tab[data-variant="underline"][aria-selected="true"] {
    border-block-end-color: var(--color-accent);
    font: var(--type-tab-current);
  }

  .tabs[data-variant="code"] {
    gap: 0;
    grid-template-areas: "list actions" "panel panel";
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .tabs[data-variant="code"]::before {
    background-color: var(--color-control);
    border-block-end: var(--border) solid var(--color-border);
    border-start-end-radius: var(--radius-md);
    border-start-start-radius: var(--radius-md);
    box-shadow: var(--shadow-rim);
    content: "";
    grid-column: list-start / actions-end;
    grid-row: list-start / list-end;
    pointer-events: none;
  }

  .tabs-actions {
    align-items: center;
    display: flex;
    grid-area: actions;
    padding-inline: var(--space-1);
  }

  .tabs-list[data-variant="code"] {
    border: 0;
    min-inline-size: 0;
    overflow-x: auto;
    padding-inline-start: var(--space-1);
    scrollbar-width: thin;
  }

  .tabs-tab[data-variant="code"] {
    block-size: var(--control-md);
    border-radius: 0;
    flex-shrink: 0;
    gap: var(--space-1-5);
    padding-inline: var(--space-2);
    white-space: nowrap;
  }

  .tabs[data-shared-panel] {
    container-type: inline-size;
    grid-template-areas: "list";
  }

  .tabs[data-shared-panel]::before {
    display: none;
  }

  .tabs[data-shared-panel] > .tabs-list {
    gap: 0;
    padding-inline-start: var(--space-2);
  }

  .tabs[data-shared-panel] .tabs-tab {
    padding-inline: var(--space-1);
  }

  @container (min-width: 20rem) {
    .tabs[data-shared-panel] > .tabs-list {
      gap: var(--space-1);
      padding-inline-start: var(--space-1);
    }

    .tabs[data-shared-panel] .tabs-tab {
      padding-inline: var(--space-2);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .tabs-tab[data-variant="code"]:hover {
      background-color: transparent;
    }
  }

  .tabs-tab[data-variant="code"][data-state="hover"] {
    background-color: transparent;
  }

  .tabs-tab[data-variant="code"][aria-selected="true"] {
    border-block-end-color: var(--color-accent);
  }

  .tabs-tab[data-variant="code"]:focus-visible {
    outline-offset: calc(var(--space-0-5) * -1);
  }

  :where(.tabs[data-variant="code"]) > .tabs-panel[hidden] {
    display: none;
  }
</style>
