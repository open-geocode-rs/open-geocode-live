---
// The one icon set. Each icon is drawn on a 24 unit grid with round strokes, except brand marks, which are filled.
export const iconNames = [
  "arrow-right",
  "arrow-up-right",
  "arrow-down-left",
  "check",
  "chevron-down",
  "copy",
  "enter",
  "monitor",
  "moon",
  "search",
  "spinner",
  "sun",
  "x",
  "github",
] as const;

export type IconName = (typeof iconNames)[number];

export const icons: Record<IconName, { d: string; mark?: true }> = {
  "arrow-right": { d: "M5 12h14M12 5l7 7-7 7" },
  "arrow-up-right": { d: "M7 17 17 7M7 7h10v10" },
  "arrow-down-left": { d: "M17 7 7 17M17 17H7V7" },
  check: { d: "M20 6 9 17l-5-5" },
  "chevron-down": { d: "m6 9 6 6 6-6" },
  copy: { d: "M9 9h11v11H9zM5 15H4V4h11v1" },
  enter: { d: "M9 10l-5 5 5 5M20 4v7a4 4 0 0 1-4 4H4" },
  monitor: { d: "M3 4h18v12H3zM8 20h8M12 16v4" },
  moon: { d: "M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z" },
  search: { d: "M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM21 21l-5-5" },
  spinner: { d: "M12 3a9 9 0 0 1 9 9M12 21a9 9 0 0 1-9-9" },
  sun: { d: "M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" },
  x: { d: "M18 6 6 18M6 6l12 12" },
  github: {
    mark: true,
    d: "M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.1-1.46-1.1-1.46-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z",
  },
};

export interface Props {
  name: IconName;
  size?: "sm" | "md" | "lg";
  /** Read aloud when the icon stands alone. Without it the icon is hidden from assistive technology. */
  label?: string;
}

const { name, size = "md", label } = Astro.props;
const { d, mark = false } = icons[name];
---

<svg
  class="icon"
  data-size={size}
  data-mark={mark ? "" : undefined}
  viewBox="0 0 24 24"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
><path d={d} /></svg>

<style>
  .icon {
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: var(--border-strong);
  }

  .icon[data-size="sm"] {
    block-size: var(--icon-sm);
    inline-size: var(--icon-sm);
  }

  .icon[data-size="md"] {
    block-size: var(--icon-md);
    inline-size: var(--icon-md);
  }

  .icon[data-size="lg"] {
    block-size: var(--icon-lg);
    inline-size: var(--icon-lg);
  }

  .icon[data-mark] {
    fill: currentColor;
    stroke: none;
  }
</style>
