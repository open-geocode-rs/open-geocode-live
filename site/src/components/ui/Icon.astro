export interface Props {
  name: IconName;
  size?: "sm" | "md" | "lg" | "xl";
  /** Read aloud when the icon stands alone. Without it the icon is hidden from assistive technology. */
  label?: string;
}

const { name, size = "md", label } = Astro.props;
const { d, mark = false } = icons[name];
---

<svg
  class="icon"
  data-size={size}
  data-mark={mark ? "" : undefined}
  viewBox="0 0 24 24"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
><path d={d} /></svg>

<style>
  .icon {
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: var(--border-strong);
  }

  .icon[data-size="sm"] {
    block-size: var(--icon-sm);
    inline-size: var(--icon-sm);
  }

  .icon[data-size="md"] {
    block-size: var(--icon-md);
    inline-size: var(--icon-md);
  }

  .icon[data-size="lg"] {
    block-size: var(--icon-lg);
    inline-size: var(--icon-lg);
  }

  .icon[data-size="xl"] {
    block-size: var(--icon-xl);
    inline-size: var(--icon-xl);
    stroke-width: var(--icon-stroke-xl);
  }

  .icon[data-mark] {
    fill: currentColor;
    stroke: none;
  }
</style>
