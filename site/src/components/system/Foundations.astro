  .ladder[data-group="opacity"] .ladder-mark,
  .ladder[data-group="scale"] .ladder-mark {
    inline-size: var(--control-lg);
  }

  .ladder[data-group="shadow"] .ladder-mark {
    background-color: var(--color-surface);
    border-color: var(--color-border);
  }

  .ladder[data-group="control"] .ladder-mark {
