---
import Button from "../ui/Button.astro";
import Chip from "./Chip.astro";
import Section from "./Section.astro";
import { breakpoints, byGroup, contrast, paint, written, type Theme } from "./tokens";

export interface Props {
  theme: Theme;
}

const { theme } = Astro.props;

// Roles that colour text are shown as text, with their contrast. The rest are shown as fills.
const textRoles = new Set([
  "--color-foreground",
  "--color-foreground-secondary",
  "--color-foreground-muted",
  "--color-accent",
  "--color-success",
  "--color-warning",
  "--color-danger",
]);
// Marks that must stand out from the page, at 3 to 1.
const markRoles = new Set(["--color-focus", "--color-border-strong"]);
const ratio = (n: number | undefined) => (n === undefined ? "" : `${n.toFixed(2)} : 1`);

const rawGroups = ["p-colour", "p-alpha", "p-font-size", "p-leading", "p-weight", "p-tracking", "p-family"];
const componentGroups = ["map", "globe", "terminal", "syntax", "method", "button-raised", "codeblock"];
const ladders = ["space", "radius", "border", "control", "icon", "container", "layout", "shadow", "z", "opacity", "scale"];
const sample = "Forward, reverse and batch geocoding from one file";
---

<div class="foundations">
  <Section title="Colour roles" note="Text roles on the background and on the surface, with contrast. Fill roles as swatches.">
    <div class="rows">
      {
        byGroup("color").map((t) => (
          <div class="row role" data-token={t.name}>
            <code class="name">{t.name}</code>
            <code class="value">{written(theme, t)}</code>
            {textRoles.has(t.name) ? (
              <div class="pair">
                <span class="tile tile-background">
                  <span class="role-text">Aa {sample}</span>
                  <span class="ratio">{ratio(contrast(theme, t.name, "--color-background"))}</span>
                </span>
                <span class="tile tile-surface">
                  <span class="role-text">Aa {sample}</span>
                  <span class="ratio">{ratio(contrast(theme, t.name, "--color-surface"))}</span>
                </span>
              </div>
            ) : (
              <div class="pair">
                <span class="tile tile-background">
                  <span class="role-fill" />
                  <span class="ratio">{markRoles.has(t.name) ? ratio(contrast(theme, t.name, "--color-background")) : ""}</span>
                </span>
                <span class="tile tile-surface">
                  <span class="role-fill" />
                </span>
              </div>
            )}
          </div>
        ))
      }
    </div>
  </Section>

  <Section title="Type roles" note="One line of real text per role.">
    <div class="rows">
      {
        byGroup("type").map((t) => (
          <div class="row type" data-token={t.name}>
            <code class="name">{t.name}</code>
            <p class="type-sample">{sample}</p>
          </div>
        ))
      }
      {
        byGroup("tracking").map((t) => (
          <div class="row type" data-token={t.name}>
            <code class="name">{t.name}</code>
            <code class="value">{written(theme, t)}</code>
            <p class="type-sample">{t.name === "--tracking-caps" ? "SMALL CAPITALS" : sample}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section title="Raw material" note="Read only by the token files. Colours are painted from the value in the file.">
    {
      rawGroups.map((g) => (
        <div class="rows">
          {byGroup(g).map((t) => (
            <div class="row raw" data-token={t.name}>
              {g === "p-colour" && <Chip colour={paint(theme, t.name)} />}
              <code class="name">{t.name}</code>
              <code class="value">{written(theme, t)}</code>
            </div>
          ))}
        </div>
      ))
    }
  </Section>

  <Section title="Scales" note="Spacing, radius, border, sizes, layout, shadow, stacking, opacity and press scale as ladders.">
    {
      ladders.map((g) => (
        <div class="rows">
          {byGroup(g).map((t) => (
            <div class="row ladder" data-group={g} data-token={t.name}>
              <code class="name">{t.name}</code>
              <code class="value">{written(theme, t)}</code>
              <span class="ladder-track">
                <span class="ladder-mark" />
              </span>
            </div>
          ))}
        </div>
      ))
    }
  </Section>

  <Section title="Motion" note="Press play to move each box with that duration or easing. Feedback is read by scripts only and never moves anything.">
    <div class="rows">
      {
        [...byGroup("duration"), ...byGroup("ease")].map((t) => (
          <div class="row motion" data-token={t.name} data-motion>
            <code class="name">{t.name}</code>
            <code class="value">{written(theme, t)}</code>
            {t.name === "--duration-feedback" ? (
              <span class="value">Scripts only</span>
            ) : (
              <span class="motion-track">
                <span class="motion-box" />
              </span>
            )}
            {t.name !== "--duration-feedback" && <Button variant="outline" size="sm" icon="arrow-right" data-play>Play</Button>}
          </div>
        ))
      }
    </div>
  </Section>

  <Section title="Component groups" note="Each group is read by its one component. Colours are painted from the value in the file.">
    {
      componentGroups.map((g) => (
        <div class="rows">
          {byGroup(g).map((t) => (
            <div class="row raw" data-token={t.name}>
              <Chip colour={paint(theme, t.name)} />
              <code class="name">{t.name}</code>
              <code class="value">{written(theme, t)}</code>
            </div>
          ))}
        </div>
      ))
    }
  </Section>

  <Section title="Docs frame" note="The variables the docs frame reads, each set from a role or a scale.">
    <div class="rows">
      {
        byGroup("host").map((t) => (
          <div class="row raw" data-token={t.name}>
            <Chip colour={paint(theme, t.name)} />
            <code class="name">{t.name}</code>
            <code class="value">{written(theme, t)}</code>
          </div>
        ))
      }
    </div>
  </Section>

  <Section title="Breakpoints" note="Media queries take only these widths, in the min-width form.">
    <div class="rows">
      {
        breakpoints.map((b) => (
          <div class="row raw">
            <code class="name">(min-width: {b})</code>
          </div>
        ))
      }
    </div>
  </Section>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-play]")) {
    button.addEventListener("click", () => {
      const row = button.closest<HTMLElement>("[data-motion]");
      row?.toggleAttribute("data-moved");
    });
  }
</script>

<style>
  .foundations {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .row {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
  }

  .name {
    color: var(--color-foreground);
    font: var(--type-code);
  }

  .value {
    color: var(--color-foreground-muted);
    font: var(--type-caption);
    overflow-wrap: anywhere;
  }

  .pair {
    display: grid;
    flex-basis: 100%;
    gap: var(--space-2);
    grid-template-columns: 1fr 1fr;
  }

  .tile {
    align-items: center;
    border: var(--border) solid var(--color-border);
    border-radius: var(--radius-md);
    display: flex;
    gap: var(--space-2);
    justify-content: space-between;
    min-inline-size: 0;
    padding: var(--space-2) var(--space-3);
  }

  .tile-background {
    background-color: var(--color-background);
  }

  .tile-surface {
    background-color: var(--color-surface);
  }

  .role-text {
    font: var(--type-ui);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .role-fill {
    block-size: var(--control-sm);
    border-radius: var(--radius-sm);
    flex-grow: 1;
  }

  .ratio {
    color: var(--color-foreground-secondary);
    flex-shrink: 0;
    font: var(--type-caption);
  }

  .type {
    align-items: baseline;
    flex-direction: column;
    gap: var(--space-1);
  }

  .type-sample {
    margin: 0;
  }

  .ladder-track {
    display: flex;
    flex-basis: var(--container-sm);
    flex-grow: 1;
    min-inline-size: 0;
  }

  .ladder-mark {
    background-color: var(--color-accent-subtle);
    border: var(--border) solid var(--color-accent);
    block-size: var(--space-4);
    max-inline-size: 100%;
  }

  @media (min-width: 40rem) {
    .ladder {
      display: grid;
      grid-template-columns: var(--layout-toc-width) var(--space-24) minmax(0, 1fr);
    }
  }

  .motion-track {
    border-block-end: var(--border) solid var(--color-border);
    flex-grow: 1;
    min-inline-size: var(--space-24);
    padding-block: var(--space-1);
  }

  .motion-box {
    background-color: var(--color-accent);
    block-size: var(--space-4);
    border-radius: var(--radius-sm);
    display: block;
    inline-size: var(--space-4);
  }

