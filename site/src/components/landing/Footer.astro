---
import logo from "../../assets/logo-light.png";
import Icon from "../ui/Icon.astro";
import HalftoneField from "./HalftoneField.astro";

const REPO = "https://github.com/open-geocode-rs/open-geocode";
const columns = [
  {
    title: "Product",
    links: [
      { label: "Documentation", href: "/docs/" },
      { label: "Quickstart", href: "/docs/quickstart/" },
      { label: "API reference", href: "/docs/api/" },
      { label: "Benchmarks", href: "/docs/benchmarks/" },
    ],
  },
  {
    title: "Guides",
    links: [
      { label: "Build a Pack", href: "/docs/guides/build-a-pack/" },
      { label: "Serve the API", href: "/docs/guides/serve/" },
      { label: "Batch geocode a CSV", href: "/docs/guides/batch-csv/" },
      { label: "Responses", href: "/docs/responses/" },
    ],
  },
  {
    title: "Project",
    links: [
      { label: "GitHub", href: REPO },
      { label: "crates.io", href: "https://crates.io/crates/open-geocode" },
      { label: "Releases", href: `${REPO}/releases` },
      { label: "License", href: `${REPO}/blob/main/LICENSE` },
    ],
  },
];
---

<footer class="og-footer">
  <div class="og-footer-card">
    <div class="og-footer-dots">
      <HalftoneField />
    </div>
    <div class="og-footer-inner">
      <div class="og-footer-brand">
        <img src={logo.src} width={logo.width} height={logo.height} alt="OpenGeocode" />
        <p>Self-hosted address geocoding in pure Rust, served from one file.</p>
        <a class="og-footer-icon" href={REPO} aria-label="OpenGeocode on GitHub"><Icon name="github" size="md" /></a>
      </div>
      {columns.map((c) => (
        <nav class="og-footer-col" aria-label={c.title}>
          <p class="og-footer-title">{c.title}</p>
          <ul>
            {c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>
      ))}
    </div>
    <p class="og-footer-legal">
      © 2026 OpenGeocode contributors · MIT License · Map data © OpenStreetMap contributors, ODbL
    </p>
  </div>
</footer>

<style>
  .og-footer {
    padding: var(--space-2);
  }

  /* The hero's card again, halftone rising from its bottom edge, so the page closes as it opens. Brand left, three
     link columns, legal below. */
  .og-footer-card {
    background-color: var(--color-background);
    border: var(--border) solid var(--color-border);
    border-radius: var(--radius-xl);
    isolation: isolate;
    margin-inline: auto;
    max-inline-size: var(--layout-page-max);
    overflow: hidden;
    padding: var(--space-12) var(--space-6) var(--space-24);
    position: relative;
  }

  /* Dots only in the open band under the legal line, since small grey text is unreadable over them. */
  .og-footer-dots {
    block-size: var(--space-24);
    inset-block-end: 0;
    inset-inline: 0;
    position: absolute;
  }

  .og-footer-inner {
    display: grid;
    gap: var(--space-8);
    grid-template-areas: "brand brand";
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    margin: 0 auto;
    max-inline-size: var(--layout-content-wide);
  }

  .og-footer-brand {
    grid-area: brand;
  }

  .og-footer-brand img {
    block-size: var(--space-6);
    inline-size: auto;
  }

  .og-footer-brand p {
    color: var(--color-foreground-secondary);
    font: var(--type-ui);
    margin: var(--space-4) 0;
    max-inline-size: var(--container-sm);
  }

  .og-footer-icon {
    color: var(--color-foreground-muted);
    display: inline-flex;
  }

  .og-footer-title {
    color: var(--color-foreground-muted);
    font: var(--type-label);
    letter-spacing: var(--tracking-caps);
    margin: 0 0 var(--space-4);
    text-transform: uppercase;
  }

  .og-footer-col ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .og-footer-col a {
    color: var(--color-foreground-secondary);
    font: var(--type-ui);
    text-decoration: none;
  }

  .og-footer-icon:focus-visible,
  .og-footer-col a:focus-visible {
    outline: var(--border-strong) solid var(--color-focus);
    outline-offset: var(--space-0-5);
  }

  @media (hover: hover) and (pointer: fine) {
    .og-footer-icon:hover,
    .og-footer-col a:hover {
      color: var(--color-foreground);
    }
  }

  .og-footer-legal {
    border-block-start: var(--border) solid var(--color-border);
    color: var(--color-foreground-secondary);
    font: var(--type-caption);
    margin: var(--space-12) auto 0;
    max-inline-size: var(--layout-content-wide);
    padding-block-start: var(--space-6);
  }

  @media (min-width: 50rem) {
    .og-footer-inner {
      grid-template-areas: "brand . . .";
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
    }
  }
</style>
