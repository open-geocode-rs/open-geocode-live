---
// A framed box split in two, the section's copy on the left and its own content on the right, stacked on narrow
// screens. One placement for every split section, so eyebrows and headings line up section to section.
import Corners from "./Corners.astro";

interface Props {
  /** The heading's id, which names the section. */
  id: string;
  eyebrow: string;
  title: string;
}

const { id, eyebrow, title } = Astro.props;
---

<section class="split" aria-labelledby={id}>
  <div class="split-box">
    <Corners />
    <div class="split-copy">
      <div class="split-top">
        <p class="split-eyebrow">{eyebrow}</p>
        <slot name="top" />
      </div>
      <h2 class="split-title" id={id}>{title}</h2>
      <slot />
    </div>
    <div class="split-aside">
      <slot name="aside" />
    </div>
  </div>
</section>

<style>
  .split {
    margin: 0 auto var(--space-24);
    max-inline-size: var(--layout-content-wide);
  }

  .split-box {
    background-color: var(--color-background);
    border: var(--border) solid var(--color-border);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    position: relative;
  }

  .split-copy {
    align-self: start;
    padding: var(--space-10) var(--space-5);
  }

  .split-top {
    align-items: baseline;
    display: flex;
    gap: var(--space-4);
    justify-content: space-between;
    margin-block-end: var(--space-3);
  }

  .split-eyebrow {
    color: var(--color-foreground-muted);
    font: var(--type-label);
    letter-spacing: var(--tracking-caps);
    margin: 0;
    text-transform: uppercase;
  }

  .split-title {
    font: var(--type-h1);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-4);
    text-wrap: balance;
  }

  .split-copy > :global(p) {
    color: var(--color-foreground-secondary);
    font: var(--type-ui);
    margin: 0 0 var(--space-3);
  }

  .split-aside {
    border-block-start: var(--border) solid var(--color-border);
    display: flex;
    flex-direction: column;
    min-inline-size: 0;
  }

  @media (min-width: 72rem) {
    .split-box {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .split-copy {
      padding: var(--space-8);
    }

    .split-aside {
      border-block-start: 0;
      border-inline-start: var(--border) solid var(--color-border);
    }
  }
</style>
