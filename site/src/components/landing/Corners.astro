---
// A small square on each corner of a framed box. The box is positioned, and each square sits centred on its corner.
const corners = ["start-start", "start-end", "end-start", "end-end"];
---

{corners.map((corner) => <span class="corner" data-corner={corner} aria-hidden="true"></span>)}

<style>
  .corner {
    background-color: var(--color-background);
    block-size: var(--space-3);
    border: var(--border) solid var(--color-border);
    border-radius: var(--radius-sm);
    inline-size: var(--space-3);
    position: absolute;
    z-index: var(--z-raised);
  }

  .corner[data-corner^="start"] {
    inset-block-start: calc(var(--space-1-5) * -1);
  }

  .corner[data-corner^="end"] {
    inset-block-end: calc(var(--space-1-5) * -1);
  }

  .corner[data-corner$="-start"] {
    inset-inline-start: calc(var(--space-1-5) * -1);
  }

  .corner[data-corner$="-end"] {
    inset-inline-end: calc(var(--space-1-5) * -1);
  }
</style>
