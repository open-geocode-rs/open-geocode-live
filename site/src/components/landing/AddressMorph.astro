---
interface Props {
  examples: [address: string, coordinates: string][];
  placeholder: string;
}

const { examples, placeholder } = Astro.props;
---

<og-address-morph class="og-morph" data-examples={JSON.stringify(examples)}>
  <span class="sr-only">{examples.map(([address, coordinates]) => `${address} geocodes to ${coordinates}.`).join(" ")}</span>
  <span class="og-morph-text" aria-hidden="true">{examples[0][0]}</span>
  <span class="og-morph-line" hidden>
    <span class="og-morph-field" data-value={placeholder}>
      <input
        class="og-morph-input"
        type="text"
        size="1"
        aria-label="Type an address or place, then press Enter"
        autocomplete="off"
        spellcheck="false"
        placeholder={placeholder}
      />
    </span>
    <span class="og-keys">
      <button type="button" class="og-key og-enter" disabled>
        Search
        <span class="og-key-disc" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="m9 10-5 5 5 5M20 4v7a4 4 0 0 1-4 4H4" /></svg>
        </span>
      </button>
      <button type="button" class="og-key og-clear" hidden>
        Clear
        <span class="og-key-disc"><kbd>esc</kbd></span>
      </button>
    </span>
  </span>
</og-address-morph>

<script>
  const HOLD = 2200;
  const STAGGER = 28;
  const SETTLE = 380;
  const GLYPHS = "0123456789.,-/abcdefghijklmnopqrstuvwxyz";

  // Each character scrambles, then settles on its target left to right, line by line.
  // Lines are fixed before it starts: left to wrap itself, the scrambled text would
  // re-break on every frame wherever the random glyphs land.
  function morph(set: (text: string) => void, from: string[], to: string[]): Promise<void> {
    const rows = Array.from({ length: Math.max(from.length, to.length) }, (_, k) => [from[k] ?? "", to[k] ?? ""]);
    const length = rows.reduce((sum, [f, t]) => sum + Math.max(f.length, t.length), 0);
    const start = performance.now();
    return new Promise((done) => {
      const step = (now: number) => {
        const t = now - start;
        let offset = 0;
        const lines = rows.map(([f, g]) => {
          let out = "";
          for (let i = 0; i < Math.max(f.length, g.length); i++) {
            const at = (offset + i) * STAGGER;
            if (t >= at + SETTLE) out += g[i] ?? "";
            else if (t >= at) out += g[i] === " " ? " " : GLYPHS[(Math.random() * GLYPHS.length) | 0];
            else out += f[i] ?? "";
          }
          offset += Math.max(f.length, g.length);
          return out.trimEnd();
        });
        set(lines.join("\n").trimEnd());
        if (t < (length - 1) * STAGGER + SETTLE) requestAnimationFrame(step);
        else {
          set(to.join("\n"));
          done();
        }
      };
      requestAnimationFrame(step);
    });
  }

  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

  type Hit = { label: string; coordinates: string };
  type Feature = {
    geometry: { coordinates: [number, number] };
    properties: { label: string; context?: Record<string, { name: string } | undefined> };
  };

  // undefined when search can't be reached, null when it found nothing: only the
  // first falls back to the examples.
  async function search(query: string): Promise<Hit | null | undefined> {
    try {
      const response = await fetch(`/api/search?${new URLSearchParams({ q: query, limit: "1" })}`);
      if (!response.ok) return undefined;
      const feature: Feature | undefined = (await response.json()).features?.[0];
      if (!feature) return null;
      const [lon, lat] = feature.geometry.coordinates;
      const { label, context = {} } = feature.properties;
      // Labels often already name the city or region; add only the places they omit.
      const places = [context.locality?.name, context.region?.name, context.country?.name].filter(
        (name): name is string => !!name && !label.toLowerCase().includes(name.toLowerCase()),
      );
      return {
        label: [label, ...new Set(places)].join(", "),
        coordinates: `${lat.toFixed(5)}, ${lon.toFixed(5)}`,
      };
    } catch {
      return undefined;
    }
  }
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Cycles address, coordinates, next address... In editing mode the same line becomes
  // an input in the same type, and Enter morphs what was typed into its coordinates.
  class AddressMorph extends HTMLElement {
    #editing = false;
    #morphing = false;
    #measure?: CanvasRenderingContext2D;
    #searching = false;
    #resume?: () => void;
    #examples: string[][] = [];
    #text!: HTMLElement;
    #line!: HTMLElement;
    #field!: HTMLElement;
    #input!: HTMLInputElement;
    #enter!: HTMLButtonElement;
    #clear!: HTMLButtonElement;

    connectedCallback() {
      this.#text = this.querySelector<HTMLElement>(".og-morph-text")!;
      this.#line = this.querySelector<HTMLElement>(".og-morph-line")!;
      this.#field = this.querySelector<HTMLElement>(".og-morph-field")!;
      this.#input = this.querySelector<HTMLInputElement>(".og-morph-input")!;
      this.#enter = this.querySelector<HTMLButtonElement>(".og-enter")!;
      this.#clear = this.querySelector<HTMLButtonElement>(".og-clear")!;
      this.#examples = JSON.parse(this.dataset.examples ?? "[]");
      const cancel = () => this.dispatchEvent(new CustomEvent("og-cancel", { bubbles: true }));
      this.#text.addEventListener("click", () => this.dispatchEvent(new CustomEvent("og-edit", { bubbles: true })));
      // Keeps focus in the input, so its blur can't end editing before the click lands.
      for (const key of [this.#enter, this.#clear]) key.addEventListener("mousedown", (event) => event.preventDefault());
      this.#enter.addEventListener("click", () => this.geocode());
      this.#clear.addEventListener("click", () => this.clear());
      this.#input.addEventListener("keydown", (event) => {
        // Enter also confirms the characters of an input method (Japanese, Chinese,
        // Korean...); that Enter is part of typing, not a search.
        if (event.isComposing || event.keyCode === 229) return;
        if (event.key === "Enter") this.geocode();
        // Esc presses Clear while it shows; with nothing to clear it leaves search.
        if (event.key === "Escape" && !this.#searching) {
          if (this.#clear.hidden) cancel();
          else this.clear();
        }
      });
      // Coordinates on show are an answer, not a draft: the next keystroke starts a new
      // query instead of editing them.
      const clearAnswer = () => {
        if (!("answer" in this.#input.dataset)) return false;
        delete this.#input.dataset.answer;
        this.#input.value = "";
        this.#fit();
        this.#setReady(false);
        return true;
      };
      // An input method composes in place, so clear before it starts, not mid-word.
      this.#input.addEventListener("compositionstart", clearAnswer);
      this.#input.addEventListener("beforeinput", (event) => {
        if (clearAnswer() && event.inputType.startsWith("delete")) event.preventDefault();
      });
      this.#input.addEventListener("input", () => {
        this.#fit();
        this.#setReady(!!this.#input.value.trim());
        this.#showClear(false);
      });
      // Clicking away without having typed anything returns to the examples.
      this.#input.addEventListener("blur", () => {
        if (!this.#input.value.trim()) cancel();
      });
      this.#cycle();
    }

    // The headline empties to a blinking caret where it stood: plainly a place to type.
    startEditing() {
      this.#editing = true;
      this.#text.hidden = true;
      this.#line.hidden = false;
      this.#input.value = "";
      this.#fit();
      delete this.#input.dataset.answer;
      this.#setReady(false);
      this.#showClear(false);
      this.#input.focus();
    }

    stopEditing() {
      this.#editing = false;
      this.#line.hidden = true;
      this.#text.hidden = false;
      this.#resume?.();
    }

    async geocode() {
      const query = this.#input.value.trim();
      if (!query) {
        this.#input.focus();
        return;
      }
      if (this.#searching) return;
      this.#setReady(false);
      // Read-only from the search until the answer lands, so keys pressed meanwhile
      // can't fight the morph over the text.
      this.#searching = true;
      this.#input.readOnly = true;
      let hit = await search(query);
      if (hit === undefined) {
        const q = query.toLowerCase();
        const example = this.#examples.find(([address]) => {
          const a = address.toLowerCase();
          return a.includes(q) || q.includes(a);
        });
        if (example) hit = { label: example[0], coordinates: example[1] };
      }
      this.dispatchEvent(new CustomEvent("og-result", { bubbles: true, detail: hit }));
      if (hit) {
        const set = (text: string) => {
          this.#input.value = text;
          this.#fit();
        };
        if (still) set(hit.coordinates);
        else await morph(set, [this.#input.value], [hit.coordinates]);
        this.#input.dataset.answer = "";
        this.#input.scrollLeft = 0;
      }
      this.#input.readOnly = false;
      this.#searching = false;
      this.#showClear(true);
    }

    clear() {
      if (this.#searching) return;
      this.#input.value = "";
      delete this.#input.dataset.answer;
      this.#fit();
      this.#setReady(false);
      this.#showClear(false);
      this.dispatchEvent(new CustomEvent("og-clear", { bubbles: true }));
      this.#input.focus();
    }

    #setReady(ready: boolean) {
      this.#enter.disabled = !ready;
    }

    // Search and Clear take turns in one spot: Clear once a search lands, Search again
    // on the next keystroke.
    #showClear(show: boolean) {
      this.#clear.hidden = !show;
      this.#enter.hidden = show;
    }

    // The field's hidden twin of the text sizes it, so the key follows the text.
    #fit() {
      this.#field.dataset.value = this.#input.value || this.#input.placeholder;
    }

    // Where the text would wrap at the headline's width: one line if it fits, else two
    // split where the longer is shortest, as text-wrap: balance would, else as many as
    // it takes.
    #lines(text: string): string[] {
      const style = getComputedStyle(this.#text);
      const ctx = (this.#measure ??= document.createElement("canvas").getContext("2d")!);
      ctx.font = `${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
      const spacing = parseFloat(style.letterSpacing) || 0;
      const width = (line: string) => ctx.measureText(line).width + spacing * line.length;
      const room = this.clientWidth;
      if (width(text) <= room) return [text];
      const words = text.split(" ");
      let best: string[] | undefined;
      let widest = Infinity;
      for (let k = 1; k < words.length; k++) {
        const pair = [words.slice(0, k).join(" "), words.slice(k).join(" ")];
        const w = Math.max(...pair.map(width));
        if (w <= room && w < widest) [best, widest] = [pair, w];
      }
      if (best) return best;
      const out: string[] = [];
      let line = "";
      for (const word of words) {
        const longer = line ? `${line} ${word}` : word;
        if (line && width(longer) > room) {
          out.push(line);
          line = word;
        } else line = longer;
      }
      return [...out, line];
    }

    async #cycle() {
      const steps = this.#examples.flat();
      await document.fonts.ready;
      const set = (text: string) => (this.#text.textContent = text);
      let shown = this.#lines(steps[0] ?? "");
      set(shown.join("\n"));
      // A new width re-breaks the text on show; one mid-morph is caught by the next step.
      new ResizeObserver(() => {
        if (!this.#morphing) set((shown = this.#lines(shown.join(" "))).join("\n"));
      }).observe(this);
      for (let i = 0; this.isConnected && steps.length > 1; i = (i + 1) % steps.length) {
        await wait(HOLD);
        if (this.#editing) await new Promise<void>((r) => (this.#resume = r));
        const next = this.#lines(steps[(i + 1) % steps.length]);
        this.#morphing = true;
        if (still) set(next.join("\n"));
        else await morph(set, shown, next);
        this.#morphing = false;
        shown = next;
      }
    }
  }

  customElements.define("og-address-morph", AddressMorph);
</script>
