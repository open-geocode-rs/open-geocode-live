---
interface Props {
  examples: [address: string, coordinates: string][];
}

const { examples } = Astro.props;
---

<og-address-morph class="og-morph" data-examples={JSON.stringify(examples)}>
  <span class="sr-only">{examples.map(([address, coordinates]) => `${address} geocodes to ${coordinates}.`).join(" ")}</span>
  <span
    class="og-morph-text"
    role="button"
    tabindex="0"
    aria-label="Search an address"
    aria-haspopup="dialog"
    aria-controls="address-search"
    data-address-search-open
  >{examples[0][0]}</span>
</og-address-morph>

<script>
  // Frame timings of the headline, in milliseconds. How long each address shows, the delay from one character's
  // scramble to the next, and how long a character scrambles before it settles.
  const SHOW = { hold: 2200, stagger: 28, settle: 380 };
  const GLYPHS = "0123456789.,-/abcdefghijklmnopqrstuvwxyz";
  // Hebrew, Arabic, Syriac, Thaana and N'Ko, and their presentation forms.
  const RTL = /[\u0590-\u07FF\uFB1D-\uFDFF\uFE70-\uFEFF]/;

  // Each character scrambles, then settles on its target left to right, line by line.
  // Lines are fixed before it starts: left to wrap itself, the scrambled text would
  // re-break on every frame wherever the random glyphs land.
  function morph(set: (text: string) => void, from: string[], to: string[]): Promise<void> {
    const rows = Array.from({ length: Math.max(from.length, to.length) }, (_, k) => [from[k] ?? "", to[k] ?? ""]);
    const length = rows.reduce((sum, [f, t]) => sum + Math.max(f.length, t.length), 0);
    const start = performance.now();
    return new Promise((done) => {
      const step = (now: number) => {
        const t = now - start;
        let offset = 0;
        const lines = rows.map(([f, g]) => {
          let out = "";
          for (let i = 0; i < Math.max(f.length, g.length); i++) {
            const at = (offset + i) * SHOW.stagger;
            if (t >= at + SHOW.settle) out += g[i] ?? "";
            else if (t >= at) out += g[i] === " " ? " " : GLYPHS[(Math.random() * GLYPHS.length) | 0];
            else out += f[i] ?? "";
          }
          offset += Math.max(f.length, g.length);
          return out.trimEnd();
        });
        set(lines.join("\n").trimEnd());
        if (t < (length - 1) * SHOW.stagger + SHOW.settle) requestAnimationFrame(step);
        else {
          set(to.join("\n"));
          done();
        }
      };
      requestAnimationFrame(step);
    });
  }

  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  class AddressMorph extends HTMLElement {
    #morphing = false;
    #coordinates = "";
    #measure?: CanvasRenderingContext2D;
    #examples: string[][] = [];
    #text!: HTMLElement;

    connectedCallback() {
      this.#text = this.querySelector<HTMLElement>(".og-morph-text")!;
      this.#examples = JSON.parse(this.dataset.examples ?? "[]");
      this.#text.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;
        event.preventDefault();
        if (!event.repeat) this.#text.click();
      });
      this.#cycle();
    }

    showCoordinates(lat: number, lon: number) {
      this.#coordinates = `${lat.toFixed(5)}, ${lon.toFixed(5)}`;
      this.#text.dir = "ltr";
      this.#text.textContent = this.#lines(this.#coordinates).join("\n");
      this.#text.setAttribute("aria-description", this.#coordinates);
    }

    // Where the text would wrap at the headline's width: one line if it fits, else two
    // split where the longer is shortest, as text-wrap: balance would, else as many as
    // it takes.
    #lines(text: string): string[] {
      const style = getComputedStyle(this.#text);
      const ctx = (this.#measure ??= document.createElement("canvas").getContext("2d")!);
      ctx.font = `${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
      const spacing = parseFloat(style.letterSpacing) || 0;
      const width = (line: string) => ctx.measureText(line).width + spacing * line.length;
      const room = this.clientWidth;
      if (width(text) <= room) return [text];
      const words = text.split(" ");
      let best: string[] | undefined;
      let widest = Infinity;
      for (let k = 1; k < words.length; k++) {
        const pair = [words.slice(0, k).join(" "), words.slice(k).join(" ")];
        const w = Math.max(...pair.map(width));
        if (w <= room && w < widest) [best, widest] = [pair, w];
      }
      if (best) return best;
      const out: string[] = [];
      let line = "";
      for (const word of words) {
        const longer = line ? `${line} ${word}` : word;
        if (line && width(longer) > room) {
          out.push(line);
          line = word;
        } else line = longer;
      }
      return [...out, line];
    }

    async #cycle() {
      const steps = this.#examples.flat();
      await document.fonts.ready;
      const set = (text: string) => {
        if (!this.#coordinates) this.#text.textContent = text;
      };
      // Arabic and Hebrew read right to left, so "1 شارع" keeps its number on the
      // right. Set before a morph, so the scramble already runs in that direction.
      const direct = (text: string) => (this.#text.dir = RTL.test(text) ? "rtl" : "ltr");
      if (!this.#coordinates) direct(steps[0] ?? "");
      let shown = this.#lines(steps[0] ?? "");
      set(shown.join("\n"));
      // A new width re-breaks the text on show; one mid-morph is caught by the next step.
      new ResizeObserver(() => {
        if (this.#coordinates) this.#text.textContent = this.#lines(this.#coordinates).join("\n");
        else if (!this.#morphing) set((shown = this.#lines(shown.join(" "))).join("\n"));
      }).observe(this);
      for (let i = 0; this.isConnected && steps.length > 1; i = (i + 1) % steps.length) {
        await wait(SHOW.hold);
        if (this.#coordinates || !this.isConnected) return;
        const next = this.#lines(steps[(i + 1) % steps.length]);
        direct(steps[(i + 1) % steps.length]);
        this.#morphing = true;
        if (still) set(next.join("\n"));
        else await morph(set, shown, next);
        this.#morphing = false;
        shown = next;
      }
    }
  }

  customElements.define("og-address-morph", AddressMorph);
</script>

<style>
  /* The reserved second line keeps longer examples from shifting the page. */
  .og-morph {
    display: flex;
    flex-direction: column;
    font: var(--type-display);
    inline-size: 100%;
    justify-content: flex-end;
    letter-spacing: var(--tracking-display);
    min-block-size: 2lh;
    text-align: center;
    text-wrap: balance;
  }

  .og-morph-text {
    cursor: pointer;
    white-space: pre;
  }

  .og-morph-text:focus-visible {
    outline: var(--border-strong) solid var(--color-focus);
    outline-offset: var(--space-1);
  }

  @media (min-width: 52rem) {
    .og-morph {
      display: block;
      min-block-size: 1lh;
    }
  }
</style>
