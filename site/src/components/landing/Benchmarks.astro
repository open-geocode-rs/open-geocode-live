---
// Figures are the benchmarks page's (src/content/docs/benchmarks.md); keep the two in step.
type Row = { name: string; bar: number; value: string; extra: string; og?: boolean };
type Tab = { id: string; label: string; title: string; sub: string; cols: [string, string]; rows: Row[]; note: string };

const RUN = "Every OpenStreetMap address in the Netherlands · each engine alone, memory capped";
const BOX = `${RUN} · 16 vCPU / 64 GiB`;
const tabs: Tab[] = [
  {
    id: "accuracy",
    label: "Accuracy",
    title: "Geocoding real web addresses",
    sub: "First answer within 20 km, % of queries (higher is better)",
    cols: ["GH4", "GH6"],
    rows: [
      { name: "Google Maps", bar: 98.6, value: "98.6%", extra: "88.3%" },
      { name: "open-geocode", bar: 93.9, value: "93.9%", extra: "78.0%", og: true },
      { name: "TomTom", bar: 91.8, value: "91.8%", extra: "79.4%" },
      { name: "OpenCage", bar: 90.2, value: "90.2%", extra: "68.2%" },
      { name: "Pelias", bar: 85.9, value: "85.9%", extra: "67.8%" },
      { name: "Photon", bar: 84.9, value: "84.9%", extra: "62.8%" },
      { name: "Nominatim", bar: 66.6, value: "66.6%", extra: "55.6%" },
    ],
    note: "MESSY STREETS · 959 web addresses · other rows from the paper · og on its Planet Pack",
  },
  {
    id: "throughput",
    label: "Throughput",
    title: "Serving a country",
    sub: "Requests per second with p99 under 100 ms (higher is better)",
    cols: ["Forward", "Reverse"],
    rows: [
      { name: "open-geocode", bar: 14087, value: "14,087", extra: "65,606+", og: true },
      { name: "Pelias", bar: 2323, value: "2,323", extra: "2,406" },
      { name: "Photon", bar: 2194, value: "2,194", extra: "3,098" },
    ],
    note: `${BOX} · reverse capped by the load generator`,
  },
  {
    id: "latency",
    label: "Latency",
    title: "Answering one query",
    sub: "One request at a time · milliseconds (lower is better)",
    cols: ["p50", "p99"],
    rows: [
      { name: "open-geocode", bar: 0.72, value: "0.72", extra: "4.2", og: true },
      { name: "Photon", bar: 2.0, value: "2.0", extra: "19.4" },
      { name: "Pelias", bar: 4.7, value: "4.7", extra: "9.6" },
    ],
    note: BOX,
  },
  {
    id: "memory",
    label: "Memory",
    title: "Serving 100 requests a second",
    sub: "Least memory to serve 100 req/s, in GiB (lower is better)",
    cols: ["GiB", "vCPU"],
    rows: [
      { name: "open-geocode", bar: 1, value: "1", extra: "1", og: true },
      { name: "Photon", bar: 4, value: "4", extra: "2" },
      { name: "Pelias", bar: 8, value: "8", extra: "1" },
    ],
    note: `${RUN} · page cache included`,
  },
];
---

<section class="og-bench" aria-labelledby="og-bench-title">
  <div class="og-bench-box">
    <span class="og-corner" aria-hidden="true"></span>
    <span class="og-corner" aria-hidden="true"></span>
    <span class="og-corner" aria-hidden="true"></span>
    <span class="og-corner" aria-hidden="true"></span>
    <div class="og-bench-copy">
      <p class="og-walk-eyebrow">Benchmarks</p>
      <h2 id="og-bench-title">Paid-API accuracy. None of the weight.</h2>
      <p>
        On real web addresses, og puts more answers in the right city than TomTom or OpenCage, and trails TomTom by
        1.4 points at street level. Against open-source engines it isn't close: the whole Netherlands on 1&nbsp;vCPU
        and 1&nbsp;GiB, at 0.72&nbsp;ms a query and 6× the throughput of Photon and Pelias.
      </p>
      <a class="og-bench-link" href="/docs/benchmarks/">Read the full benchmarks →</a>
    </div>
    <og-bench-tabs class="og-bench-chart">
      <div class="og-bench-tabs" role="tablist" aria-label="Benchmark">
        {tabs.map((t, i) => (
          <button type="button" role="tab" id={`og-bench-tab-${t.id}`} aria-controls={`og-bench-${t.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
            {t.label}
          </button>
        ))}
      </div>
      {tabs.map((t, i) => {
        const max = Math.max(...t.rows.map((r) => r.bar));
        return (
          <div class:list={["og-bench-panel", { "og-bench-dense": t.rows.length > 4 }]} role="tabpanel" id={`og-bench-${t.id}`} aria-labelledby={`og-bench-tab-${t.id}`} hidden={i !== 0}>
            <h3>{t.title}</h3>
            <p class="og-bench-sub">{t.sub}</p>
            <table>
              <thead>
                <tr>
                  <th scope="col"><span class="sr-only">Geocoder</span></th>
                  <th scope="col"><span class="sr-only">Bar</span></th>
                  <th scope="col">{t.cols[0]}</th>
                  <th scope="col">{t.cols[1]}</th>
                </tr>
              </thead>
              <tbody>
                {t.rows.map((r) => (
                  <tr class:list={{ "og-bench-og": r.og }}>
                    <th scope="row">{r.name}</th>
                    <td class="og-bench-bar" aria-hidden="true">
                      <span style={`width: ${Math.max(1.5, (r.bar / max) * 100)}%`}></span>
                    </td>
                    <td class="og-bench-value">{r.value}</td>
                    <td class="og-bench-extra">{r.extra}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="og-bench-note">
              {t.note}
              <a href="/docs/benchmarks/">method</a>
            </p>
          </div>
        );
      })}
    </og-bench-tabs>
  </div>
</section>

<script>
  // Panels are all in the HTML for readers and crawlers; this only switches them.
  class BenchTabs extends HTMLElement {
    connectedCallback() {
      const tabs = [...this.querySelectorAll<HTMLButtonElement>("[role=tab]")];
      const select = (tab: HTMLButtonElement) => {
        for (const t of tabs) {
          const on = t === tab;
          t.setAttribute("aria-selected", String(on));
          t.tabIndex = on ? 0 : -1;
          this.querySelector<HTMLElement>(`#${t.getAttribute("aria-controls")}`)!.hidden = !on;
        }
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener("click", () => select(tab));
        tab.addEventListener("keydown", (e) => {
          const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
          if (!step) return;
          const next = tabs[(i + step + tabs.length) % tabs.length];
          select(next);
          next.focus();
        });
      });
    }
  }

  customElements.define("og-bench-tabs", BenchTabs);
</script>
