---
import Link from "../ui/Link.astro";
import Tabs from "../ui/Tabs.astro";
import Split from "./Split.astro";

// Figures are the benchmarks page's (src/content/docs/benchmarks.mdx); keep the two in step.
type Row = { name: string; bar: number; value: string; extra: string; og?: boolean };
type Tab = { id: string; label: string; title: string; sub: string; cols: [string, string]; rows: Row[]; note: string };

const RUN = "Every OpenStreetMap address in the Netherlands · each engine alone, memory capped";
const BOX = `${RUN} · 16 vCPU / 64 GiB`;
const tabs: Tab[] = [
  {
    id: "accuracy",
    label: "Accuracy",
    title: "Geocoding real web addresses",
    sub: "First answer within 20 km, % of queries (higher is better)",
    cols: ["GH4", "GH6"],
    rows: [
      { name: "Google Maps", bar: 98.6, value: "98.6%", extra: "88.3%" },
      { name: "open-geocode", bar: 93.9, value: "93.9%", extra: "78.0%", og: true },
      { name: "TomTom", bar: 91.8, value: "91.8%", extra: "79.4%" },
      { name: "OpenCage", bar: 90.2, value: "90.2%", extra: "68.2%" },
      { name: "Pelias", bar: 85.9, value: "85.9%", extra: "67.8%" },
      { name: "Photon", bar: 84.9, value: "84.9%", extra: "62.8%" },
      { name: "Nominatim", bar: 66.6, value: "66.6%", extra: "55.6%" },
    ],
    note: "MESSY STREETS · 959 web addresses · other rows from the paper · og on its Planet Pack",
  },
  {
    id: "throughput",
    label: "Throughput",
    title: "Serving a country",
    sub: "Requests per second with p99 under 100 ms (higher is better)",
    cols: ["Forward", "Reverse"],
    rows: [
      { name: "open-geocode", bar: 14087, value: "14,087", extra: "65,606+", og: true },
      { name: "Pelias", bar: 2323, value: "2,323", extra: "2,406" },
      { name: "Photon", bar: 2194, value: "2,194", extra: "3,098" },
    ],
    note: `${BOX} · reverse capped by the load generator`,
  },
  {
    id: "latency",
    label: "Latency",
    title: "Answering one query",
    sub: "One request at a time · milliseconds (lower is better)",
    cols: ["p50", "p99"],
    rows: [
      { name: "open-geocode", bar: 0.72, value: "0.72", extra: "4.2", og: true },
      { name: "Photon", bar: 2.0, value: "2.0", extra: "19.4" },
      { name: "Pelias", bar: 4.7, value: "4.7", extra: "9.6" },
    ],
    note: BOX,
  },
  {
    id: "memory",
    label: "Memory",
    title: "Serving 100 requests a second",
    sub: "Least memory to serve 100 req/s, in GiB (lower is better)",
    cols: ["GiB", "vCPU"],
    rows: [
      { name: "open-geocode", bar: 1, value: "1", extra: "1", og: true },
      { name: "Photon", bar: 4, value: "4", extra: "2" },
      { name: "Pelias", bar: 8, value: "8", extra: "1" },
    ],
    note: `${RUN} · page cache included`,
  },
];

// Each bar is its share of the tab's longest, never so short it disappears.
const share = (row: Row, rows: Row[]) => Math.max(0.015, row.bar / Math.max(...rows.map((r) => r.bar)));
---

<Split id="og-bench-title" eyebrow="Benchmarks" title="Paid-API accuracy. None of the weight.">
  <p>
    On real web addresses, og puts more answers in the right city than TomTom or OpenCage, and trails TomTom by 1.4
    points at street level. Against open-source engines it isn't close: the whole Netherlands on 1&nbsp;vCPU and
    1&nbsp;GiB, at 0.72&nbsp;ms a query and 6× the throughput of Photon and Pelias.
  </p>
  <Link variant="standalone" href="/docs/benchmarks/">Read the full benchmarks</Link>
  <div class="og-bench-chart" slot="aside">
    <Tabs id="og-bench" label="Benchmark" tabs={tabs.map((t) => ({ id: t.id, label: t.label }))}>
      {
        tabs.map((t) => (
          <div class="og-bench-panel" data-dense={t.rows.length > 4 ? "" : undefined} slot={t.id}>
            <h3>{t.title}</h3>
            <p class="og-bench-sub">{t.sub}</p>
            <table>
              <thead>
                <tr>
                  <th scope="col">
                    <span class="sr-only">Geocoder</span>
                  </th>
                  <th scope="col">
                    <span class="sr-only">Bar</span>
                  </th>
                  <th scope="col">{t.cols[0]}</th>
                  <th scope="col">{t.cols[1]}</th>
                </tr>
              </thead>
              <tbody>
                {t.rows.map((r) => (
                  <tr data-og={r.og ? "" : undefined}>
                    <th scope="row">{r.og ? <strong>{r.name}</strong> : r.name}</th>
                    <td class="og-bench-bar" aria-hidden="true">
                      <span style={`--value: ${share(r, t.rows)}`} />
                    </td>
                    <td class="og-bench-value">{r.og ? <strong>{r.value}</strong> : r.value}</td>
                    <td class="og-bench-extra">{r.extra}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="og-bench-note">
              {t.note} <Link href="/docs/benchmarks/">method</Link>
            </p>
          </div>
        ))
      }
    </Tabs>
  </div>
</Split>

<style>
  /* The tab labels sit a tab's padding in from the chart's edge, and the panels line up with them. */
  .og-bench-chart {
    padding: var(--space-6) var(--space-2);
  }

  .og-bench-panel {
    padding-inline: var(--space-3);
  }

  .og-bench-panel h3 {
    font: var(--type-h4);
    margin: 0;
  }

  .og-bench-sub {
    color: var(--color-foreground-muted);
    font: var(--type-caption);
    margin: var(--space-1) 0 var(--space-6);
  }

  .og-bench-panel table {
    border-collapse: collapse;
    font: var(--type-ui);
    inline-size: 100%;
    table-layout: fixed;
  }

  .og-bench-panel th,
  .og-bench-panel td {
    padding: var(--space-1) 0;
  }

  .og-bench-panel thead th {
    color: var(--color-foreground-muted);
    font: var(--type-label);
    letter-spacing: var(--tracking-caps);
    text-align: end;
    text-transform: uppercase;
  }

  .og-bench-panel th:nth-child(1) {
    inline-size: 28%;
  }

  .og-bench-panel th:nth-child(2) {
    inline-size: 36%;
  }

  .og-bench-panel th:nth-child(3),
  .og-bench-panel th:nth-child(4) {
    inline-size: 18%;
  }

  .og-bench-panel tbody th {
    color: var(--color-foreground-secondary);
    font: var(--type-ui);
    text-align: start;
  }

  .og-bench-panel [data-og] th {
    color: var(--color-foreground);
  }

  .og-bench-bar {
    padding-inline-end: var(--space-3);
  }

  /* The bar's length is the row's share of the longest, passed as data. */
  .og-bench-bar span {
    background-color: var(--color-foreground);
    block-size: var(--space-6);
    display: block;
    inline-size: calc(var(--value) * 100%);
    min-inline-size: var(--space-1);
  }

  .og-bench-panel [data-og] .og-bench-bar span {
    background-color: var(--color-success);
  }

  /* A tab with more rows draws them thinner, so every tab keeps about the height of four. */
  .og-bench-panel[data-dense] th,
  .og-bench-panel[data-dense] td {
    padding-block: var(--space-0-5);
  }

  .og-bench-panel[data-dense] .og-bench-bar span {
    block-size: var(--space-3);
  }

  .og-bench-value,
  .og-bench-extra {
    font: var(--type-code);
    font-variant-numeric: tabular-nums;
    text-align: end;
    white-space: nowrap;
  }

  .og-bench-value {
    color: var(--color-foreground-secondary);
  }

  .og-bench-panel [data-og] .og-bench-value {
    color: var(--color-foreground);
  }

  .og-bench-extra {
    color: var(--color-foreground-muted);
  }

  .og-bench-note {
    border-block-start: var(--border) solid var(--color-border);
    color: var(--color-foreground-muted);
    font: var(--type-caption);
    margin: var(--space-4) 0 0;
    padding-block-start: var(--space-3);
  }

  @media (min-width: 72rem) {
    .og-bench-chart {
      padding-inline: var(--space-5);
    }
  }
</style>
