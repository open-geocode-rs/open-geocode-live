---
import logoLight from "../../assets/logo-light.png";
import Button from "../ui/Button.astro";
import Icon, { type IconName } from "../ui/Icon.astro";
import Link from "../ui/Link.astro";
import Disc from "./Disc.astro";

const REPO = "https://github.com/open-geocode-rs/open-geocode";

const menus: { label: string; items: { label: string; href: string; icon: IconName }[] }[] = [
  {
    label: "Solutions",
    items: [
      { label: "Forward geocoding", href: "/docs/api/operations/geocode/", icon: "map-pin" },
      { label: "Autocomplete", href: "/docs/api/operations/autocomplete/", icon: "search" },
      { label: "Reverse geocoding", href: "/docs/api/operations/reverse/", icon: "crosshair" },
      { label: "Batch geocoding", href: "/docs/guides/batch-csv/", icon: "table" },
    ],
  },
  {
    label: "Resources",
    items: [
      { label: "Documentation", href: "/docs/", icon: "book" },
      { label: "API reference", href: "/docs/api/", icon: "code" },
      { label: "Benchmarks", href: "/docs/benchmarks/", icon: "chart" },
      { label: "GitHub", href: REPO, icon: "github" },
    ],
  },
];
---

<header class="og-header">
  <a href="/" class="og-logo" aria-label="OpenGeocode home">
    <img src={logoLight.src} width={logoLight.width} height={logoLight.height} alt="" />
  </a>
  <nav class="og-nav" aria-label="Main">
    {
      menus.map((menu) => (
        <div class="og-menu">
          <Button variant="ghost" size="lg" aria-haspopup="true">
            {menu.label}
            <Icon name="chevron-down" size="sm" />
          </Button>
          <div class="og-menu-panel">
            <div class="og-menu-band">
              <div class="og-menu-items">
              {menu.items.map((item) => (
                <Button variant="raised" size="lg" href={item.href}>
                  <Disc icon={item.icon} edge="start" />
                  {item.label}
                </Button>
              ))}
              </div>
            </div>
          </div>
        </div>
      ))
    }
    <div class="og-menu">
      <Button variant="ghost" size="lg" aria-haspopup="true">
        Pricing
        <Icon name="chevron-down" size="sm" />
      </Button>
      <div class="og-menu-panel">
        <div class="og-menu-band">
          <div class="og-menu-items">
            <p class="og-pricing">
              <strong>$0.</strong> No tiers, no seats, no per-lookup fees, no sales call. It's MIT, so <Link href={REPO}>just take it</Link>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </nav>
  <div class="og-actions">
    <Button variant="ghost" size="lg" icon="github" href={REPO}>GitHub</Button>
  </div>
</header>

<style>
  /* Logo and menus on the left, actions pushed to the right. Above the hero, so an open menu's band lies over it. */
  .og-header {
    align-items: center;
    background-color: var(--color-background);
    block-size: var(--layout-nav-height);
    border-block-end: var(--border) dashed var(--color-border);
    display: flex;
    gap: var(--space-8);
    padding-inline: var(--layout-gutter);
    position: relative;
    z-index: var(--z-sticky);
  }

  .og-logo {
    display: flex;
  }

  .og-logo img {
    block-size: var(--space-8);
    inline-size: auto;
  }

  /* Each menu fills the header's height, so the pointer stays on it from the trigger down to the band. */
  .og-nav {
    align-self: stretch;
    display: none;
    gap: var(--space-2);
  }

  @media (min-width: 50rem) {
    .og-nav {
      display: flex;
    }
  }

  /* Static, so the band positions against the whole header. */
  .og-menu {
    align-items: center;
    display: flex;
    position: static;
  }

  /* A full-width band just under the header's rule, which is the header's last pixel. It unrolls downward from the
     rule, and rolls back up after a short grace, so crossing the rule on the way down does not shut it. */
  .og-menu-panel {
    background-color: var(--color-background);
    border-block-end: var(--border) dashed var(--color-border);
    box-shadow: var(--shadow-raised);
    display: grid;
    grid-template-rows: 0fr;
    inset-block-start: var(--layout-nav-height);
    inset-inline: 0;
    opacity: 0;
    position: absolute;
    visibility: hidden;
  }

  .og-menu:focus-within .og-menu-panel {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
  }

  @media (hover: hover) and (pointer: fine) {
    .og-menu:hover .og-menu-panel {
      grid-template-rows: 1fr;
      opacity: 1;
      visibility: visible;
    }
  }

  /* The band's clipping wrapper has no padding of its own, so a rolled up band keeps no height. */
  .og-menu-band {
    min-block-size: 0;
    overflow: hidden;
  }

  .og-menu-items {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    padding: var(--space-4) var(--layout-gutter) var(--space-5);
  }

  .og-pricing {
    color: var(--color-foreground-muted);
    font: var(--type-ui);
    margin: 0;
    padding-block: var(--space-2);
  }

  .og-pricing strong {
    color: var(--color-foreground);
  }

  .og-actions {
    display: flex;
    gap: var(--space-2);
    margin-inline-start: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .og-menu-panel {
      transition:
        grid-template-rows var(--duration-panel) var(--ease-out) var(--duration-press),
        opacity var(--duration-enter) var(--ease-out) var(--duration-press),
        visibility var(--duration-panel) var(--ease-out) var(--duration-press);
    }

    .og-menu:focus-within .og-menu-panel {
      transition:
        grid-template-rows var(--duration-panel) var(--ease-out),
        opacity var(--duration-enter) var(--ease-out),
        visibility var(--duration-panel) var(--ease-out);
    }
  }

  @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
    .og-menu:hover .og-menu-panel {
      transition:
        grid-template-rows var(--duration-panel) var(--ease-out),
        opacity var(--duration-enter) var(--ease-out),
        visibility var(--duration-panel) var(--ease-out);
    }

    /* Moving to the other menu swaps bands at once instead of stacking two. */
    :where(.og-nav:has(.og-menu:hover)) .og-menu:not(:hover) .og-menu-panel {
      transition: none;
    }
  }
</style>
