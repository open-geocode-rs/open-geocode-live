<og-dither-globe class="og-globe">
  <canvas aria-hidden="true"></canvas>
</og-dither-globe>

<script>
  import { geoEquirectangular, geoPath } from "d3-geo";
  import { feature } from "topojson-client";
  import type { GeometryCollection, Topology } from "topojson-specification";
  import land110 from "world-atlas/land-110m.json";

  // 8x8 Bayer matrix: ordered dithering keeps the pattern stable from frame to frame,
  // so rotation reads as motion instead of noise.
  const BAYER = [
    0, 32, 8, 40, 2, 34, 10, 42, 48, 16, 56, 24, 50, 18, 58, 26, 12, 44, 4, 36, 14, 46, 6, 38, 60, 28, 52, 20, 62, 30,
    54, 22, 3, 35, 11, 43, 1, 33, 9, 41, 51, 19, 59, 27, 49, 17, 57, 25, 15, 47, 7, 39, 13, 45, 5, 37, 63, 31, 55, 23,
    61, 29, 53, 21,
  ].map((v) => (v + 0.5) / 64);

  const MASK_W = 1024;
  const MASK_H = 512;
  const CELL = 3; // CSS px per dither dot
  const TILT = (-22 * Math.PI) / 180;
  const SPEED = 0.12; // radians per second
  const LIGHT = normalize([-0.35, 0.7, 0.62]);
  const TAU = Math.PI * 2;
  // The card shows only the top of the disc: down to about 0.5 of the radius on wide
  // screens, 0.35 on phones. A found place turns to this height, inside both.
  const PLACE_Y = 0.72;
  const FLY = 1400; // ms to turn to a place

  function normalize([x, y, z]: number[]) {
    const l = Math.hypot(x, y, z);
    return [x / l, y / l, z / l];
  }

  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);
  const wrap = (a: number) => a - Math.round(a / TAU) * TAU;

  // Land as an equirectangular bitmap, rasterised once: per-frame lookups are then a
  // single array read instead of a point-in-polygon test.
  function landMask(): Uint8Array {
    const canvas = new OffscreenCanvas(MASK_W, MASK_H);
    const ctx = canvas.getContext("2d")!;
    const topo = land110 as unknown as Topology<{ land: GeometryCollection }>;
    const projection = geoEquirectangular()
      .scale(MASK_W / (2 * Math.PI))
      .translate([MASK_W / 2, MASK_H / 2]);
    ctx.fillStyle = "#fff";
    ctx.beginPath();
    geoPath(projection, ctx)(feature(topo, topo.objects.land));
    ctx.fill();
    const rgba = ctx.getImageData(0, 0, MASK_W, MASK_H).data;
    const mask = new Uint8Array(MASK_W * MASK_H);
    for (let i = 0; i < mask.length; i++) mask[i] = rgba[i * 4 + 3] > 127 ? 1 : 0;
    return mask;
  }

  function rgba(css: string): number {
    const probe = document.createElement("canvas").getContext("2d")!;
    probe.fillStyle = css;
    probe.fillRect(0, 0, 1, 1);
    const [r, g, b, a] = probe.getImageData(0, 0, 1, 1).data;
    // ImageData is little-endian RGBA when read through a Uint32Array.
    return ((a << 24) | (b << 16) | (g << 8) | r) >>> 0;
  }

  // Spins until a search lands, then turns and tilts the place into view and stops.
  class DitherGlobe extends HTMLElement {
    #frame = 0;
    #visible = true;
    #turn?: (lat: number, lon: number) => void;
    #release?: () => void;

    turnTo(lat: number, lon: number) {
      this.#turn?.(lat, lon);
    }

    release() {
      this.#release?.();
    }

    connectedCallback() {
      const canvas = this.querySelector("canvas")!;
      // Sized from the rendered width, so each dither dot stays CELL px at any size.
      const n = Math.max(32, Math.round(this.getBoundingClientRect().width / CELL));
      canvas.width = n;
      canvas.height = n;
      const ctx = canvas.getContext("2d")!;
      const image = ctx.createImageData(n, n);
      const pixels = new Uint32Array(image.data.buffer);
      const mask = landMask();

      // Light is fixed to the screen, so shading, glow and dither thresholds are
      // worked out once. Latitude row and base longitude depend on tilt, which only
      // changes while turning to a place.
      const radius = n / 2 - 1;
      const cells: number[][] = [];
      for (let j = 0; j < n; j++) {
        for (let i = 0; i < n; i++) {
          const x = (i + 0.5 - n / 2) / radius;
          const y = (n / 2 - j - 0.5) / radius;
          const d = x * x + y * y;
          if (d > 1) continue;
          const z = Math.sqrt(1 - d);
          cells.push([
            j * n + i,
            x,
            y,
            z,
            Math.max(0, x * LIGHT[0] + y * LIGHT[1] + z * LIGHT[2]),
            // Screen-space falloff from the upper middle of the disc, the part above
            // the card's edge: ocean dots shine there and thin out toward the rim.
            Math.max(0, 1 - Math.hypot(x, y - 0.55) / 1.1),
            BAYER[(j % 8) * 8 + (i % 8)],
          ]);
        }
      }
      const count = cells.length;
      const column = (c: number) => Float32Array.from(cells, (cell) => cell[c]);
      const idx = Int32Array.from(cells, (cell) => cell[0]);
      const [xs, ys, zs, shade, glow, threshold] = [1, 2, 3, 4, 5, 6].map(column);
      const row = new Int32Array(count);
      const lon0 = new Float32Array(count);

      const project = (tilt: number) => {
        const c = Math.cos(tilt);
        const s = Math.sin(tilt);
        for (let k = 0; k < count; k++) {
          const ty = ys[k] * c - zs[k] * s;
          const tz = ys[k] * s + zs[k] * c;
          const lat = Math.asin(Math.max(-1, Math.min(1, ty)));
          row[k] = Math.min(MASK_H - 1, Math.floor(((Math.PI / 2 - lat) / Math.PI) * MASK_H)) * MASK_W;
          lon0[k] = Math.atan2(xs[k], tz);
        }
      };

      let landShadow = 0;
      let land = 0;
      let landLit = 0;
      let landPeak = 0;
      let ocean = 0;
      let sea = 0;
      let seaLit = 0;
      const readColours = () => {
        const style = getComputedStyle(this);
        const colour = (name: string) => rgba(style.getPropertyValue(name));
        landShadow = colour("--og-globe-land-shadow");
        land = colour("--og-globe-land");
        landLit = colour("--og-globe-land-lit");
        landPeak = colour("--og-globe-land-peak");
        ocean = colour("--og-globe-ocean");
        sea = colour("--og-globe-sea");
        seaLit = colour("--og-globe-sea-lit");
      };
      readColours();

      let spin = -0.15;
      let tilt = TILT;
      let held = false;
      let fly: { spin0: number; spin1: number; tilt0: number; tilt1: number; start: number } | null = null;
      project(tilt);

      const render = () => {
        pixels.fill(0);
        for (let k = 0; k < count; k++) {
          let lon = lon0[k] - spin;
          lon -= Math.floor((lon + Math.PI) / TAU) * TAU;
          const col = Math.min(MASK_W - 1, Math.floor(((lon + Math.PI) / TAU) * MASK_W));
          const t = threshold[k];
          if (mask[row[k] + col] === 1) {
            // Land is solid, stepped by light: dark green in shadow, the logo green,
            // mint where lit and white at the brightest point.
            const b = 0.32 + 0.68 * shade[k];
            pixels[idx[k]] =
              b - 0.95 > t * 0.06 ? landPeak : b - 0.78 > t * 0.35 ? landLit : b > t ? land : landShadow;
          } else {
            // Ocean: navy, grey-blue dots where lit, light grey where the glow peaks.
            // Opaque, so the card's halftone stops at the rim instead of beating
            // against the globe's own dots.
            const o = 0.03 + 0.1 * shade[k] + 0.34 * glow[k];
            pixels[idx[k]] = o - 0.3 > t * 0.6 ? seaLit : o > t ? sea : ocean;
          }
        }
        ctx.putImageData(image, 0, 0);
      };

      new MutationObserver(() => {
        readColours();
        render();
      }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const flyTo = (spin1: number, tilt1: number) => {
        if (still) {
          spin = spin1;
          tilt = tilt1;
          project(tilt);
          render();
        } else fly = { spin0: spin, spin1, tilt0: tilt, tilt1, start: performance.now() };
      };

      this.#turn = (lat, lon) => {
        const phi = (lat * Math.PI) / 180;
        const lambda = (lon * Math.PI) / 180;
        held = true;
        flyTo(spin + wrap(-lambda - spin), Math.asin(PLACE_Y) - phi);
      };
      this.#release = () => {
        if (!held) return;
        held = false;
        flyTo(spin, TILT);
      };

      render();
      if (still) return;

      new IntersectionObserver(([entry]) => (this.#visible = entry.isIntersecting)).observe(this);
      let last = performance.now();
      // Only redraws while something moves: a settled globe costs nothing.
      const step = (now: number, dt: number) => {
        if (fly) {
          const t = Math.min(1, (now - fly.start) / FLY);
          const e = ease(t);
          spin = fly.spin0 + (fly.spin1 - fly.spin0) * e;
          tilt = fly.tilt0 + (fly.tilt1 - fly.tilt0) * e;
          project(tilt);
          if (t === 1) fly = null;
          return true;
        }
        if (held) return false;
        spin += dt * SPEED;
        return true;
      };
      const tick = (now: number) => {
        const dt = Math.min(0.05, (now - last) / 1000);
        last = now;
        if (this.#visible && !document.hidden && step(now, dt)) render();
        this.#frame = requestAnimationFrame(tick);
      };
      this.#frame = requestAnimationFrame(tick);
    }

    disconnectedCallback() {
      cancelAnimationFrame(this.#frame);
    }
  }

  customElements.define("og-dither-globe", DitherGlobe);
</script>
