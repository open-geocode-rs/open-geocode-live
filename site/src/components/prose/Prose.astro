---
import type { ProseNode } from "../../lib/prose";
import CodeBlock from "../ui/CodeBlock.astro";
import type { IconName } from "../ui/Icon.astro";
import Link from "../ui/Link.astro";
import Tabs from "../ui/Tabs.astro";
import Aside from "./Aside.astro";
import CodeTabs from "./CodeTabs.astro";
import Heading from "./Heading.astro";

export interface Props {
  nodes: ProseNode[];
}

const { nodes } = Astro.props;
// Languages typed at a prompt. Their blocks take the terminal look.
const shell = new Set(["sh", "bash", "shell", "shellscript", "zsh", "console", "shellsession", "powershell", "ps", "ps1", "bat", "batch", "cmd"]);
const codeTabIcons = new Map<string, IconName>([["TypeScript", "typescript"], ["cURL", "terminal"]]);
---

{
  nodes.map((node) => {
    switch (node.kind) {
      case "html":
        return <Fragment set:html={node.html} />;
      case "element": {
        const Tag = node.tag;
        return (
          <Tag {...node.attrs}>
            <Astro.self nodes={node.children} />
          </Tag>
        );
      }
      case "link":
        return (
          <Link href={node.href} {...node.attrs}>
            <Astro.self nodes={node.children} />
          </Link>
        );
      case "heading":
        return (
          <Heading level={node.level} id={node.id} label={node.label}>
            <Astro.self nodes={node.children} />
          </Heading>
        );
      case "code":
        return <CodeBlock variant={shell.has(node.lang) ? "terminal" : "plain"} code={node.code} lang={node.lang} />;
      case "aside":
        return (
          <Aside tone={node.tone} title={node.title}>
            <Astro.self nodes={node.children} />
          </Aside>
        );
      case "tabs": {
        const panels = node.tabs.map(({ id, label, children }) => {
          const content = children.filter((child) => child.kind !== "html" || child.html.trim());
          const block = content.at(-1);
          const notes = content.slice(0, -1);
          if (block?.kind !== "code" || notes.some((child) => child.kind === "code" || child.kind === "tabs")) return undefined;
          return { id, label, icon: codeTabIcons.get(label), block, notes };
        });
        if (panels.every((panel) => panel !== undefined)) {
          return (
            <CodeTabs id={node.id} label={node.label} {panels}>
              {panels.filter((panel) => panel.notes.length > 0).map((panel) => (
                <div slot={panel.id} class="prose-flow"><Astro.self nodes={panel.notes} /></div>
              ))}
            </CodeTabs>
          );
        }
        return (
          <Tabs variant="underline" id={node.id} label={node.label} tabs={node.tabs}>
            {node.tabs.map((t) => (
              <div slot={t.id} class="prose-flow">
                <Astro.self nodes={t.children} />
              </div>
            ))}
          </Tabs>
        );
      }
    }
  })
}
