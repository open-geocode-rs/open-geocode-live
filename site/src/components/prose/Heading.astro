---
import type { Level } from "../../lib/prose";
import Icon from "../ui/Icon.astro";

export interface Props {
  level: Level;
  id: string;
  /** Read aloud for the link to the heading. */
  label: string;
}

const { level, id, label } = Astro.props;
const Tag = `h${level}` as const;
---

<div class="prose-heading" data-level={level}>
  <Tag class="heading-text" id={id}><slot /></Tag>
  <a class="heading-anchor" href={`#${id}`}><Icon name="link" label={label} /></a>
</div>

<style>
  .prose-heading {
    color: var(--color-foreground);
    font: var(--type-h4);
  }

  .prose-heading[data-level="2"] {
    font: var(--type-h2);
  }

  .prose-heading[data-level="3"] {
    font: var(--type-h3);
  }

  .heading-text {
    display: inline;
    font: inherit;
  }

  .heading-anchor {
    border-radius: var(--radius-sm);
    color: var(--color-accent);
    display: inline-flex;
    margin-inline-start: var(--space-2);
    vertical-align: middle;
  }

  .heading-anchor:focus-visible {
    outline: var(--border-strong) solid var(--color-focus);
    outline-offset: var(--space-0-5);
  }

  /* With a pointer the link shows on the heading's hover or the link's focus, and on touch it always shows. */
  @media (hover: hover) and (pointer: fine) {
    .heading-anchor {
      opacity: 0;
    }

    .prose-heading:hover .heading-anchor,
    .heading-anchor:focus-visible {
      opacity: 1;
    }

    .heading-anchor:hover {
      color: var(--color-accent-strong);
    }
  }
</style>
