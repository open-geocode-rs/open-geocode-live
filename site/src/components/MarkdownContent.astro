---
import { isApiPage } from "../lib/openapi";
import { proseOf } from "../lib/prose";
import { downloads } from "./frame/links";
import Prose from "./prose/Prose.astro";

const { id } = Astro.locals.starlightRoute;
// The API reference pages are drawn by their own components, and every other page is the docs prose.
const api = isApiPage(id);
const downloadPage = `/${id}/` === downloads.href;
const stackTables = id.startsWith("docs/compatibility/") || [
  "docs/compatibility",
  "docs/guides/typescript",
].includes(id);
const nodes = api ? [] : proseOf(await Astro.slots.render("default"), { stackTables, downloadCards: id === "docs/installation" });
---

{
  api ? (
    <slot />
  ) : (
    <div class="prose prose-flow" data-download-catalog={downloadPage ? "" : undefined}>
      <Prose nodes={nodes} />
    </div>
  )
}

<style>
  [data-download-catalog] :global(table) {
    border-block: var(--border) solid var(--color-border);
    display: table;
    inline-size: 100%;
    max-inline-size: var(--container-lg);
  }

  [data-download-catalog] :global(:is(th, td)) {
    padding-block: var(--space-2);
    padding-inline: 0;
    vertical-align: middle;
  }

  [data-download-catalog] :global(:is(th, td) + :is(th, td)) {
    padding-inline-start: var(--space-3);
  }

  [data-download-catalog] :global(td) {
    padding-block: var(--space-3);
  }

  [data-download-catalog] :global(th),
  [data-download-catalog] :global(td:last-child),
  [data-download-catalog] :global(td time) {
    color: var(--color-foreground-secondary);
  }

  [data-download-catalog] :global(th) {
    font: var(--type-ui-strong);
  }

  [data-download-catalog] :global(:is(th, td):nth-child(3)),
  [data-download-catalog] :global(a[download]) {
    white-space: nowrap;
  }

  [data-download-catalog] :global(a[download]) {
    text-decoration-line: underline;
  }

  [data-download-catalog] :global(tbody tr:last-child td) {
    border-block-end: 0;
  }
</style>
