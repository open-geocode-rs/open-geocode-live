---
import type { Block, Field } from "../../lib/reference";
import Badge from "../ui/Badge.astro";
import Icon from "../ui/Icon.astro";
import Link from "../ui/Link.astro";
import Example from "./Example.astro";
import Markdown from "./Markdown.astro";

interface Props {
  blocks: Block[];
  /** A field's blocks sit close under its name. A whole body's blocks sit a step apart. */
  density: "field" | "body";
}

const { blocks, density } = Astro.props;
---

<div class="blocks" data-density={density}>
  {
    blocks.map((block) => {
      switch (block.kind) {
        case "text":
          return (
            <div class="text">
              <Markdown text={block.markdown} />
            </div>
          );
        case "title":
          return (
            <p class="text">
              <em>{block.text}</em>
            </p>
          );
        case "docs":
          return (
            <p class="text">
              <Link href={block.href} variant="standalone">
                {block.label}
              </Link>
            </p>
          );
        case "type":
          return (
            <p class="tags">
              <span class="type">{block.type.text}</span>
              {block.type.format && <Badge variant="code" size="sm">format: {block.type.format}</Badge>}
            </p>
          );
        case "tags":
          return (
            <p class="tags">
              {block.label && <span class="tags-label">{block.label}</span>}
              {block.tags.map((tag) => (
                <Badge variant="code" size="sm">{tag}</Badge>
              ))}
            </p>
          );
        case "example":
          return <Example example={block.example} />;
        case "object": {
          const list = (
            <div class="fields">
              {block.tags.length > 0 && (
                <p class="tags">
                  {block.tags.map((tag) => (
                    <Badge variant="code" size="sm">{tag}</Badge>
                  ))}
                </p>
              )}
              {block.fields.map((field: Field) => (
                <div class="field">
                  <p class="field-line">
                    <span>
                      <strong>{field.deprecated ? <s>{field.name}</s> : field.name}</strong>{field.required ? ":" : ": optional"}
                    </span>
                    {field.type && <span class="type">{field.type.text}</span>}
                    {field.type?.format && <Badge variant="code" size="sm">format: {field.type.format}</Badge>}
                    {field.deprecated && <Badge variant="warning">deprecated</Badge>}
                  </p>
                  {field.blocks.length > 0 && <Astro.self blocks={field.blocks} density="field" />}
                </div>
              ))}
            </div>
          );
          return block.open ? (
            list
          ) : (
            <details class="nested">
              <summary class="nested-toggle">
                <span class="nested-caret">
                  <Icon name="chevron-down" size="sm" />
                </span>
                Properties
              </summary>
              <div class="nested-list">{list}</div>
            </details>
          );
        }
      }
    })
  }
</div>

<style>
  .blocks {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-inline-size: 0;
  }

  .blocks[data-density="field"] {
    font: var(--type-ui);
    gap: var(--space-1);
  }

  .text {
    color: var(--color-foreground);
  }

  /* A description's own paragraphs and lists sit a step apart, closer than the blocks around them. */
  :global(:where(.text > * + *)) {
    margin-block-start: var(--space-2);
  }

  .tags {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1-5);
  }

  .tags-label {
    color: var(--color-foreground-muted);
  }

  .type {
    color: var(--color-foreground);
    font: var(--type-code);
  }

  .fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .field {
    display: flex;
    flex-direction: column;
  }

  .field-line {
    align-items: baseline;
    color: var(--color-foreground);
    display: flex;
    flex-wrap: wrap;
    font: var(--type-ui);
    gap: var(--space-1);
    overflow-wrap: anywhere;
  }

  .nested-toggle {
    align-items: center;
    border-radius: var(--radius-sm);
    color: var(--color-foreground-secondary);
    cursor: pointer;
    display: inline-flex;
    font: var(--type-ui-strong);
    gap: var(--space-1);
    list-style: none;
    user-select: none;
  }

  .nested-toggle::-webkit-details-marker {
    display: none;
  }

  .nested-caret {
    display: inline-flex;
    rotate: -90deg;
  }

  [open] > .nested-toggle > .nested-caret {
    rotate: 0deg;
  }

  @media (hover: hover) and (pointer: fine) {
    .nested-toggle:hover {
      color: var(--color-foreground);
    }
  }

  .nested-toggle:focus-visible {
    outline: var(--border-strong) solid var(--color-focus);
    outline-offset: var(--space-0-5);
  }

  /* An object's fields hang off a hairline under its toggle. */
  .nested-list {
    border-inline-start: var(--border) solid var(--color-border);
    margin-block-start: var(--space-1);
    padding-inline-start: var(--space-6);
  }

  @media (prefers-reduced-motion: no-preference) {
    .nested-caret {
      transition: rotate var(--duration-enter) var(--ease-in-out);
    }
  }
</style>
