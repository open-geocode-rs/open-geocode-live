---
import { exampleFor, snippetsFor } from "../../lib/api";
import type { ApiOperation } from "../../lib/openapi";
import Badge from "../ui/Badge.astro";
import Card from "../ui/Card.astro";
import CodeBlock from "../ui/CodeBlock.astro";
import Menu from "../ui/Menu.astro";

interface Props {
  operation: ApiOperation;
}

const { operation } = Astro.props;
const example = exampleFor(operation);
const snippets = snippetsFor(example);
const { response } = example;
const languages = snippets.map((s) => ({ value: s.id, label: s.label }));
---

<aside class="request-example" aria-label="Example request" data-request-example>
  <Card variant="framed">
    <div class="request-head">
      <div class="request-title">
        <Badge variant={operation.method} />
        <span class="sr-only">{operation.method.toUpperCase()}</span>
        <h3 class="request-summary">{operation.title}</h3>
      </div>
      <Menu label="Language" items={languages} current={snippets[0].id} triggerIcon="code" size="sm" align="end" />
    </div>
    {
      snippets.map((s, i) => (
        <div class="request-snippet" data-snippet={s.id} hidden={i > 0}>
          <CodeBlock code={s.code} lang={s.lang} />
        </div>
      ))
    }
    {
      response && (
        <div class="request-response">
          <CodeBlock variant="titled" title="200 example" code={response} lang="json" />
        </div>
      )
    }
  </Card>
</aside>

<script>
  const KEY = "og-snippet";

  /** Shows one language in every example on the page, and marks it in each picker. */
  function show(id: string) {
    for (const panel of document.querySelectorAll<HTMLElement>("[data-request-example]")) {
      const panes = [...panel.querySelectorAll<HTMLElement>("[data-snippet]")];
      if (!panes.some((p) => p.dataset.snippet === id)) continue;
      for (const p of panes) p.hidden = p.dataset.snippet !== id;
      panel.querySelector("details[data-menu]")?.dispatchEvent(new CustomEvent("menu-select", { detail: id }));
    }
  }

  for (const panel of document.querySelectorAll<HTMLElement>("[data-request-example]")) {
    panel.addEventListener("menu-change", (event) => {
      if (!(event instanceof CustomEvent) || typeof event.detail !== "string") return;
      show(event.detail);
      try {
        localStorage.setItem(KEY, event.detail);
      } catch {}
    });
  }

  try {
    const saved = localStorage.getItem(KEY);
    if (saved) show(saved);
  } catch {}
</script>

<style>
  .request-head {
    align-items: center;
    display: flex;
    gap: var(--space-2);
    justify-content: space-between;
  }

  .request-title {
    align-items: center;
    display: flex;
    gap: var(--space-2);
    min-inline-size: 0;
  }

  .request-summary {
    color: var(--color-foreground);
    font: var(--type-ui-strong);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* A long answer scrolls inside the panel, so the panel stays within the window beside the page. */
  .request-response {
    border-radius: var(--radius-lg);
    max-block-size: var(--container-md);
    overflow-y: auto;
  }
</style>
