---
import { exampleFor, snippetsFor } from "../../lib/api";
import type { ApiOperation } from "../../lib/openapi";
import Badge from "../ui/Badge.astro";
import Button from "../ui/Button.astro";
import CodeBlock from "../ui/CodeBlock.astro";
import Menu, { type MenuItem } from "../ui/Menu.astro";
import ResponseDetails from "./ResponseDetails.astro";
import TryMap from "./TryMap.astro";

interface Props {
  operation: ApiOperation;
}

const { operation } = Astro.props;
const hasTryIt = operation.method === "get" && ["/autocomplete", "/geocode", "/places", "/reverse"].includes(operation.path);
const example = exampleFor(operation);
const snippets = snippetsFor(example);
const { response } = example;
const languageIcons = { sh: "terminal", js: "javascript", python: "python" } as const;
const languages: MenuItem[] = snippets.map(({ id, label, lang }) => ({
  value: id,
  label,
  icon: languageIcons[lang],
}));
---

<aside class="request-example" aria-label="Example request" data-request-example data-interactive={hasTryIt ? "" : undefined}>
  <div class="request-card" data-example-fixed>
    <div class="request-head">
      <div class="request-title">
        <Badge variant={operation.method} />
        <span class="sr-only" data-pagefind-ignore>{operation.method.toUpperCase()}</span>
        <h3 class="request-summary">{operation.title}</h3>
      </div>
      <div class="request-controls">
        <div data-snippet-picker data-pagefind-ignore>
          <Menu label="Language" current={snippets[0].id} items={languages} variant="outline" size="2xs" align="end" />
        </div>
        <Button variant="outline" iconOnly icon="copy" label="Copy code" data-copy-request />
        <span class="request-copied" role="status" data-copy-status></span>
      </div>
    </div>
    {
      snippets.map((s, i) => (
        <div class="request-snippet" data-snippet={s.id} hidden={i > 0}>
          <CodeBlock variant="numbered" code={s.code} lang={s.lang} />
        </div>
      ))
    }
  </div>
  {
    hasTryIt ? <TryMap {operation} {example} /> : response && (
      <ResponseDetails status="200 example">
        <CodeBlock variant="numbered" code={response} lang="json" copy />
      </ResponseDetails>
    )
  }
</aside>

<script>
  import { copyText } from "../../lib/clipboard";
  import { after } from "../../lib/motion";

  const KEY = "og-snippet";

  /** Shows one language in every example on the page, and marks it in each picker. */
  function show(id: string) {
    for (const panel of document.querySelectorAll<HTMLElement>("[data-request-example]")) {
      const panes = [...panel.querySelectorAll<HTMLElement>("[data-snippet]")];
      if (!panes.some((p) => p.dataset.snippet === id)) continue;
      for (const p of panes) p.hidden = p.dataset.snippet !== id;
      const picker = panel.querySelector<HTMLElement>("[data-snippet-picker] [data-menu]");
      if (picker) {
        picker.dataset.current = id;
        picker.dispatchEvent(new CustomEvent("menu-select", { detail: id }));
      }
    }
  }

  for (const picker of document.querySelectorAll("[data-snippet-picker]")) {
    picker.addEventListener("menu-change", (event) => {
      if (!(event instanceof CustomEvent) || typeof event.detail !== "string") return;
      show(event.detail);
      try {
        localStorage.setItem(KEY, event.detail);
      } catch {}
    });
  }

  // The panel's copy button copies the request in the language shown.
  for (const panel of document.querySelectorAll<HTMLElement>("[data-request-example]")) {
    const button = panel.querySelector<HTMLButtonElement>("[data-copy-request]");
    const status = panel.querySelector<HTMLElement>("[data-copy-status]");
    let cancel = () => {};
    button?.addEventListener("click", async () => {
      const shown = panel.querySelector<HTMLElement>(".request-snippet:not([hidden]) template[data-code]");
      if (!(shown instanceof HTMLTemplateElement)) return;
      if (!(await copyText(shown.content.textContent ?? "", panel)) || !status) return;
      status.textContent = "Copied!";
      cancel();
      // The tag stays for the feedback duration, then clears.
      cancel = after("--duration-feedback", () => {
        status.textContent = "";
      });
    });
  }

  try {
    const saved = localStorage.getItem(KEY);
    if (saved) show(saved);
  } catch {}
</script>

<style>
  /* One frame on a quiet fill. The request sits in a card with its title row, and the answer below it on the fill. */
  .request-example {
    background-color: var(--color-control);
    border: var(--border) solid var(--color-border);
    border-radius: var(--radius-xl);
    color: var(--color-foreground);
    padding: var(--space-1);
  }

  .request-card {
    background-color: var(--color-background);
    border: var(--border) solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  @media (min-width: 72rem) {
    .request-example[data-interactive] {
      display: flex;
      flex-direction: column;
    }

    .request-example[data-interactive]:where(:not(:has(:global([data-example-disclosure][open])))) {
      max-block-size: calc(100dvh - var(--layout-nav-height) - var(--space-4) - var(--space-4));
    }

    :global([data-example-flow]) .request-example[data-interactive] {
      max-block-size: none;
    }

    .request-card {
      flex-shrink: 0;
    }
  }

  .request-head {
    align-items: center;
    border-block-end: var(--border) solid var(--color-border);
    display: flex;
    gap: var(--space-2);
    justify-content: space-between;
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-3);
  }

  .request-title,
  .request-controls {
    align-items: center;
    display: flex;
    gap: var(--space-2);
  }

  /* In a narrow panel the title gives way, cut short, and the controls keep their size. */
  .request-title {
    min-inline-size: 0;
  }

  .request-controls {
    flex-shrink: 0;
  }

  /* After a copy, a filled tag beside the button says so, and it is empty, so unseen, at rest. */
  .request-copied:empty {
    display: none;
  }

  .request-copied {
    background-color: var(--color-success);
    border-radius: var(--radius-sm);
    color: var(--color-on-solid);
    font: var(--type-ui);
    padding: var(--space-0-5) var(--space-2);
  }

  .request-summary {
    color: var(--color-foreground);
    font: var(--type-ui-strong);
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .request-snippet {
    padding: var(--space-4);
  }
</style>
