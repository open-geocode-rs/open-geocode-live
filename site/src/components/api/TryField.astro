---
import Icon from "../ui/Icon.astro";
import Input from "../ui/Input.astro";

export interface Props {
  name: string;
  label: string;
  value: string;
  required: boolean;
  wide: boolean;
  type: "number" | "text";
  min?: number;
  max?: number;
  step?: number | "any";
  hint?: string;
  suggest?: boolean;
}

const { name, label, value, required, wide, type, min, max, step, hint, suggest } = Astro.props;
const hintId = hint ? `try-${name}-hint` : undefined;
const input = { id: `try-${name}`, name, value, required, type, min, max, step, "aria-describedby": hintId };
const listId = `try-${name}-suggestions`;
---

<div class="try-field" data-wide={wide ? "" : undefined}>
  <label for={`try-${name}`} class="try-label">
    {label}
    <code aria-hidden="true">{name}</code>
  </label>
  {
    suggest ? (
      <div class="try-search">
        <Input {...input} icon="search" role="combobox" aria-autocomplete="list" aria-controls={listId} aria-expanded="false" autocomplete="off" spellcheck="false" />
        <div id={listId} class="try-suggestions" role="listbox" aria-label="Suggestions" data-try-suggestions hidden></div>
        <template data-suggestion-row>
          <div class="try-suggestion" role="option" aria-selected="false">
            <Icon name="map-pin" size="md" />
            <span class="try-suggestion-label">
              <span class="try-suggestion-name"></span>
              <span class="try-suggestion-context" hidden></span>
            </span>
          </div>
        </template>
      </div>
    ) : <Input {...input} />
  }
  {hint && <span class="try-hint" id={hintId}>{hint}</span>}
</div>

<style>
  .try-field {
    display: grid;
    gap: var(--space-1);
    min-inline-size: 0;
  }

  .try-field[data-wide] {
    grid-column: start / end;
  }

  .try-label {
    align-items: baseline;
    color: var(--color-foreground);
    display: flex;
    flex-wrap: wrap;
    font: var(--type-ui-strong);
    gap: var(--space-0-5) var(--space-1-5);
  }

  .try-label > code,
  .try-hint {
    color: var(--color-foreground-secondary);
  }

  .try-label > code {
    font: var(--type-code-sm);
  }

  .try-search {
    anchor-name: --try-query;
  }

  .try-suggestions {
    background-color: var(--color-background);
    border: var(--border) solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-raised);
    box-sizing: border-box;
    inline-size: anchor-size(width);
    inset-block-start: anchor(bottom);
    inset-inline-start: anchor(left);
    margin-block: var(--space-1);
    padding: var(--space-1);
    position: fixed;
    position-anchor: --try-query;
    position-try-fallbacks: flip-block;
    z-index: var(--z-overlay);
  }

  .try-suggestion {
    align-items: center;
    border-radius: var(--radius-md);
    color: var(--color-foreground-secondary);
    cursor: pointer;
    display: flex;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
  }

  .try-suggestion-label {
    min-inline-size: 0;
  }

  .try-suggestion-name,
  .try-suggestion-context {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .try-suggestion-name {
    color: var(--color-foreground);
    font: var(--type-ui);
  }

  .try-suggestion-context {
    font: var(--type-caption);
  }

  .try-suggestion-context[hidden] {
    display: none;
  }

  .try-suggestion[aria-selected="true"] {
    background-color: var(--color-control-hover);
  }

  @media (hover: hover) and (pointer: fine) {
    .try-suggestion:hover {
      background-color: var(--color-control-hover);
    }
  }

  .try-hint {
    font: var(--type-caption);
  }
</style>
