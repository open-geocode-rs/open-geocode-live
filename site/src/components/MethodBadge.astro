---
import { METHOD_ICONS } from "../lib/api";

interface Props {
  method: string;
}

const { method } = Astro.props;
---

<span class:list={["og-method", `og-method--${method}`]}>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d={METHOD_ICONS[method]} /></svg>
  {method.toUpperCase()}
</span>
