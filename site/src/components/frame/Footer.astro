---
import Icon from "../ui/Icon.astro";
import Pagination from "./Pagination.astro";

const { editUrl, lastUpdated, lang } = Astro.locals.starlightRoute;
---

<footer class="footer">
  <div class="footer-meta">
    {
      editUrl && (
        <a class="footer-edit print:hidden" href={editUrl}>
          <Icon name="pencil" size="md" />
          {Astro.locals.t("page.editLink")}
        </a>
      )
    }
    {
      lastUpdated && (
        <p class="footer-updated">
          {Astro.locals.t("page.lastUpdated")}{" "}
          <time datetime={lastUpdated.toISOString()}>{lastUpdated.toLocaleDateString(lang, { dateStyle: "medium", timeZone: "UTC" })}</time>
        </p>
      )
    }
  </div>
  <Pagination />
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-4) 0 var(--space-16);
  }

  .footer-meta {
    color: var(--color-foreground-muted);
    display: flex;
    flex-wrap: wrap;
    font: var(--type-ui);
    gap: var(--space-3) var(--space-12);
    justify-content: space-between;
    margin-block-start: var(--space-12);
  }

  .footer-edit {
    align-items: center;
    border-radius: var(--radius-sm);
    color: var(--color-foreground-muted);
    display: flex;
    gap: var(--space-2);
    text-decoration: none;
    transition-duration: var(--duration-hover);
    transition-property: color;
    transition-timing-function: var(--ease-hover);
  }

  @media (hover: hover) and (pointer: fine) {
    .footer-edit:hover {
      color: var(--color-foreground);
    }
  }

  .footer-edit:focus-visible {
    outline: var(--border-strong) solid var(--color-focus);
    outline-offset: var(--space-0-5);
  }

  .footer-updated {
    margin: 0;
  }

  .footer-updated:only-child {
    margin-inline-start: auto;
  }
</style>
