---
import type { StarlightRouteData } from "@astrojs/starlight/route-data";

type Item = NonNullable<StarlightRouteData["toc"]>["items"][number];

interface Props {
  items: Item[];
  nested?: boolean;
}

const { items, nested = false } = Astro.props;
---

<ul class="toc-list" data-nested={nested ? "" : undefined}>
  {
    items.map((heading) => (
      <li>
        <a class="toc-link" href={`#${heading.slug}`}>
          {heading.text}
        </a>
        {heading.children.length > 0 && <Astro.self items={heading.children} nested />}
      </li>
    ))
  }
</ul>

<style>
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    padding-inline-start: var(--space-0-5);
  }

  .toc-list[data-nested] {
    padding-inline-start: var(--space-4);
  }

  .toc-link {
    border-radius: var(--radius-md);
    color: var(--color-foreground-secondary);
    display: block;
    font: var(--type-ui-compact);
    margin-inline-start: var(--space-1);
    overflow-wrap: anywhere;
    padding: var(--space-1-5) var(--space-3);
    text-decoration: none;
  }

  .toc-list[data-nested] > :where(li) > .toc-link {
    padding-inline-start: var(--space-3-5);
  }

  @media (hover: hover) and (pointer: fine) {
    .toc-link:hover {
      color: var(--color-foreground);
    }
  }

  .toc-link[aria-current="true"] {
    color: var(--color-accent);
  }

  .toc-link:focus-visible {
    outline: var(--border-strong) solid var(--color-focus);
    outline-offset: calc(var(--space-0-5) * -1);
  }
</style>
