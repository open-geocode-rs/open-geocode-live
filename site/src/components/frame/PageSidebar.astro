---
import Icon from "../ui/Icon.astro";
import TocList from "./TocList.astro";

const { toc } = Astro.locals.starlightRoute;
const title = Astro.locals.t("tableOfContents.onThisPage");
---

{
  toc && (
    <og-contents class="contents">
      <nav class="contents-bar" aria-labelledby="og-contents-bar-title">
        <details class="contents-disclosure" data-contents-disclosure>
          <summary class="contents-toggle">
            <span id="og-contents-bar-title">{title}</span>
            <span class="contents-caret">
              <Icon name="chevron-down" size="sm" />
            </span>
          </summary>
          <div class="contents-dropdown">
            <div class="contents-track" data-contents-track>
              <span class="contents-indicator" data-contents-indicator aria-hidden="true"></span>
              <TocList items={toc.items} />
            </div>
          </div>
        </details>
        <span class="contents-current" data-contents-current />
      </nav>
      <nav class="contents-column" aria-labelledby="starlight__on-this-page">
        <h2 class="contents-title" id="starlight__on-this-page">
          {title}
        </h2>
        <div class="contents-track" data-contents-track>
          <span class="contents-indicator" data-contents-indicator aria-hidden="true"></span>
          <TocList items={toc.items} />
        </div>
      </nav>
    </og-contents>
  )
}

<script>
  // Marks the section being read. A heading is current once it has scrolled up to where a jump to it lands.
  class Contents extends HTMLElement {
    connectedCallback() {
      const tracks = [...this.querySelectorAll<HTMLElement>("[data-contents-track]")];
      const links = [...this.querySelectorAll<HTMLAnchorElement>("a[href^='#']")];
      const sectionOf = (link: HTMLAnchorElement) => decodeURIComponent(link.hash.slice(1));
      const headings = [...new Set(links.map(sectionOf))].map((id) => document.getElementById(id));
      const current = this.querySelector<HTMLElement>("[data-contents-current]");
      const disclosure = this.querySelector<HTMLDetailsElement>("[data-contents-disclosure]");
      let shown = "";

      const moveIndicators = () => {
        for (const track of tracks) {
          const indicator = track.querySelector<HTMLElement>("[data-contents-indicator]");
          const active = track.querySelector<HTMLAnchorElement>('a[aria-current="true"]');
          if (!indicator || !active || active.offsetHeight === 0) continue;
          const row = active.getBoundingClientRect();
          const offset = row.top - track.getBoundingClientRect().top + (row.height - indicator.offsetHeight) / 2;
          const pixel = Math.round(offset * devicePixelRatio) / devicePixelRatio;
          indicator.style.setProperty("--value", `${pixel}px`);
          indicator.dataset.positioned = "";
        }
      };

      const mark = () => {
        const line = Number.parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
        // Inactive tab panels keep their layout rectangles to prevent the page from shifting.
        const visible = headings.filter((heading): heading is HTMLElement =>
          Boolean(heading?.getClientRects().length && !heading.closest("[hidden], [inert]")),
        );
        const reached = visible.findLast((heading) => heading.getBoundingClientRect().top <= line + 1);
        // A short final section can reach the end of the page before it reaches the reading line.
        const root = document.documentElement;
        const atBottom = scrollY > 0 && scrollY + root.clientHeight >= root.scrollHeight - 1;
        const heading = (atBottom ? visible.at(-1) : reached) ?? visible[0];
        if (!heading || heading.id === shown) return;
        shown = heading.id;
        for (const link of links) {
          if (sectionOf(link) === heading.id) link.setAttribute("aria-current", "true");
          else link.removeAttribute("aria-current");
        }
        const active = links.find((l) => l.hasAttribute("aria-current"));
        if (current && active) current.textContent = active.textContent?.trim() ?? "";
        moveIndicators();
      };

      let queued = false;
      const queue = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          mark();
        });
      };
      addEventListener("scroll", queue, { passive: true });
      addEventListener("resize", queue);
      const observer = new ResizeObserver(moveIndicators);
      for (const track of tracks) observer.observe(track);
      const main = document.querySelector("main");
      if (main) new MutationObserver(queue).observe(main, { attributeFilter: ["hidden", "inert"], subtree: true });
      mark();

      if (!disclosure) return;
      disclosure.addEventListener("toggle", moveIndicators);
      const close = () => {
        disclosure.open = false;
      };
      for (const link of disclosure.querySelectorAll("a")) link.addEventListener("click", close);
      addEventListener("click", (event) => {
        if (!disclosure.contains(event.target as Node)) close();
      });
      addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || !disclosure.open) return;
        const focused = disclosure.contains(document.activeElement);
        close();
        if (focused) disclosure.querySelector("summary")?.focus();
      });
    }
  }
  customElements.define("og-contents", Contents);
</script>

<style>
  /* No box of its own, so the column sticks within the whole height of the row. */
  .contents {
    display: contents;
  }

  /* On a phone and a tablet the list opens from a bar under the header, --space-12 tall. */
  .contents-bar {
    align-items: center;
    background-color: var(--color-surface);
    block-size: var(--space-12);
    border-block-end: var(--border) solid var(--color-border);
    display: flex;
    gap: var(--space-3);
    inset-block-start: var(--layout-nav-height);
    inset-inline: 0;
    padding-inline: var(--space-4);
    position: fixed;
    z-index: var(--z-raised);
  }

  .contents-disclosure {
    flex-shrink: 0;
  }

  .contents-toggle {
    align-items: center;
    background-color: var(--color-background);
    block-size: var(--control-md);
    border: var(--border) solid var(--color-border-control);
    border-radius: var(--radius-lg);
    color: var(--color-foreground);
    cursor: pointer;
    display: flex;
    font: var(--type-ui);
    gap: var(--space-2);
    list-style: none;
    padding-inline: var(--space-3) var(--space-2);
    user-select: none;
  }

  .contents-toggle::-webkit-details-marker {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .contents-toggle:hover {
      background-color: var(--color-control-hover);
    }
  }

  .contents-toggle:focus-visible {
    outline: var(--border-strong) solid var(--color-focus);
    outline-offset: var(--space-0-5);
  }

  .contents-caret {
    color: var(--color-foreground-muted);
    display: inline-flex;
    rotate: -90deg;
  }

  [open] > .contents-toggle > .contents-caret {
    rotate: 0deg;
  }

  .contents-current {
    color: var(--color-foreground);
    font: var(--type-ui);
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .contents-dropdown {
    background-color: var(--color-background);
    border-block: var(--border) solid var(--color-border);
    border-end-end-radius: var(--radius-lg);
    border-end-start-radius: var(--radius-lg);
    box-shadow: var(--shadow-overlay);
    inset-block-start: calc(var(--layout-nav-height) + var(--space-12));
    inset-inline: 0;
    max-block-size: calc(100dvh - var(--layout-nav-height) - var(--space-24));
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--space-2) var(--space-4);
    position: fixed;
  }

  .contents-track {
    position: relative;
  }

  .contents-track::before,
  .contents-indicator {
    border-radius: var(--radius-full);
    inline-size: var(--space-0-5);
    inset-inline-start: 0;
    pointer-events: none;
    position: absolute;
  }

  .contents-track::before {
    background-color: var(--color-border);
    content: "";
    inset-block: var(--space-1);
  }

  .contents-indicator {
    background-color: var(--color-accent);
    block-size: var(--space-5);
    inset-block-start: 0;
    transform: translateY(var(--value));
    visibility: hidden;
  }

  .contents-indicator[data-positioned] {
    visibility: visible;
  }

  .contents-column {
    display: none;
  }

  @media (min-width: 50rem) {
    .contents-bar,
    .contents-dropdown {
      inset-inline-start: calc(var(--layout-sidebar-width) + var(--layout-gutter) - var(--space-6));
    }
  }

  /* From the contents breakpoint up the list is a column beside the text that stays in view. */
  @media (min-width: 72rem) {
    .contents-bar {
      display: none;
    }

    .contents-column {
      display: block;
      inset-block-start: var(--layout-nav-height);
      max-block-size: calc(100vh - var(--layout-nav-height));
      overflow-y: auto;
      padding-block: var(--space-4);
      position: sticky;
      scrollbar-width: none;
    }
  }

  .contents-title {
    color: var(--color-foreground);
    font: var(--type-ui);
    margin: 0 0 var(--space-1-5);
  }

  @media (prefers-reduced-motion: no-preference) {
    .contents-indicator[data-positioned] {
      transition: transform var(--duration-enter) var(--ease-out);
    }

    .contents-caret {
      transition: rotate var(--duration-enter) var(--ease-in-out);
    }
  }
</style>
