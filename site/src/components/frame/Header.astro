---
import SiteTitle from "@astrojs/starlight/components/SiteTitle.astro";
import Button from "../ui/Button.astro";
import Search from "./Search.astro";
import ThemeSelect from "./ThemeSelect.astro";
import { repository } from "./links";

const id = Astro.locals.starlightRoute.id;

// Sections are matched by id prefix; Docs takes whatever no other section claims.
const sections = [
  { label: "Guides", href: "/docs/guides/build-a-pack/", match: "docs/guides/" },
  { label: "API", href: "/docs/api/", match: "docs/api" },
  { label: "Benchmarks", href: "/docs/benchmarks/", match: "docs/benchmarks" },
];
const claimed = sections.find((s) => id.startsWith(s.match));
const links = [{ label: "Docs", href: "/docs/", current: !claimed }].concat(
  sections.map((s) => ({ label: s.label, href: s.href, current: s === claimed })),
);
---

<div class="header">
  <SiteTitle />
  <nav class="header-nav" aria-label="Sections">
    {
      links.map((l) => (
        <a class="header-link" href={l.href} aria-current={l.current ? "page" : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>
  <div class="header-search print:hidden">
    <Search />
  </div>
  <div class="header-actions print:hidden">
    <Button variant="ghost" iconOnly icon="github" label={repository.label} href={repository.href} />
    <ThemeSelect />
  </div>
</div>

<style>
  .header {
    align-items: center;
    block-size: 100%;
    display: flex;
    gap: var(--space-4);
  }

  .header-nav {
    display: none;
    gap: var(--space-0-5);
    margin-inline-start: var(--space-6);
  }

  .header-link {
    border-radius: var(--radius-sm);
    color: var(--color-foreground-secondary);
    font: var(--type-ui-strong);
    padding: var(--space-1-5) calc(var(--space-2) + var(--space-0-5));
    text-decoration: none;
  }

  .header-link[aria-current="page"] {
    color: var(--color-foreground);
  }

  @media (hover: hover) and (pointer: fine) {
    .header-link:hover {
      background-color: var(--color-control);
      color: var(--color-foreground);
    }
  }

  .header-link:focus-visible {
    outline: var(--border-strong) solid var(--color-focus);
    outline-offset: var(--space-0-5);
  }

  .header-search {
    display: flex;
    flex: 1;
    justify-content: flex-end;
    min-inline-size: 0;
  }

  /* The actions sit closer to search than the header's other parts do, so search and the actions read as one group. */
  .header-actions {
    align-items: center;
    display: none;
    gap: var(--space-2);
    margin-inline-start: calc(var(--space-2) * -1);
  }

  @media (min-width: 50rem) {
    .header-nav,
    .header-actions {
      display: flex;
    }
  }
</style>
