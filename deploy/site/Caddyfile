# The site as static files on loopback; public only through the cloudflared tunnel.
# Install as /etc/caddy/Caddyfile, then `sudo systemctl reload caddy`.
{
	auto_https off
	admin localhost:2019
}

# Crawlers ignore these; robots.txt and the sitemap govern indexing.
(security) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Any host, not 127.0.0.1: tunnel requests carry the public hostname, and a site
# address that doesn't match it answers with an empty 200.
http://:8081 {
	bind 127.0.0.1
	root * /var/www/open-geocode-site
	encode zstd gzip
	import security

	# The landing palette only exposes GET autocomplete and forward geocoding.
	# Rebuild the query so callers can supply only the search text.
	@address {
		method GET
		path /api/geocode /api/autocomplete
	}
	handle @address {
		route {
			uri strip_prefix /api
			# Cloudflare's Add visitor location headers transform supplies the coarse
			# coordinates. This listener only receives Cloudflare Tunnel traffic.
			@visitor_location {
				header_regexp latitude CF-IPLatitude ^(-?(?:[0-8]?[0-9](?:\.[0-9]+)?|90(?:\.0+)?))$
				header_regexp longitude CF-IPLongitude ^(-?(?:(?:1[0-7][0-9]|[0-9]?[0-9])(?:\.[0-9]+)?|180(?:\.0+)?))$
			}
			rewrite * {path}?q={query.q}&limit=5
			rewrite @visitor_location {path}?q={query.q}&limit=5&focus={http.regexp.longitude.1},{http.regexp.latitude.1}
			reverse_proxy 127.0.0.1:8090
		}
	}

	@legacy_search {
		method GET
		path /api/search
	}
	handle @legacy_search {
		rewrite * /geocode?q={query.q}&limit=1
		reverse_proxy 127.0.0.1:8090
	}

	# /search became /geocode and /places in the engine; keep old links working.
	redir /docs/api/operations/search/ /docs/api/operations/geocode/ permanent
	redir /docs/api/operations/search.md /docs/api/operations/geocode.md permanent

	handle {
		try_files {path} {path}/index.html {path}.html
		file_server
		# Hashed filenames, so a changed file is a new URL.
		@assets path /_astro/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
	}
	# Error responses skip the site's header directives, so they import them again.
	handle_errors {
		import security
		rewrite * /404.html
		file_server
	}
}
