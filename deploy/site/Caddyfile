# The site as static files on loopback; public only through the cloudflared tunnel.
# Install as /etc/caddy/Caddyfile, then `sudo systemctl reload caddy`.
{
	auto_https off
	admin localhost:2019
}

# Crawlers ignore these; robots.txt and the sitemap govern indexing.
(security) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Any host, not 127.0.0.1: tunnel requests carry the public hostname, and a site
# address that doesn't match it answers with an empty 200.
http://:8081 {
	bind 127.0.0.1
	root * /var/www/open-geocode-site
	encode zstd gzip
	import security

	# The one API the site exposes: GET /api/search, with q alone and one result.
	# Rebuilding the query drops every other parameter, and q is re-encoded, so it
	# can't smuggle more in. Batch, reverse, other methods and other paths fall
	# through to the static files and 404 (deploy/search/open-geocode-search.service).
	@search {
		method GET
		path /api/search
	}
	handle @search {
		rewrite * /search?q={query.q}&limit=1
		reverse_proxy 127.0.0.1:8090
	}

	handle {
		try_files {path} {path}/index.html {path}.html
		file_server
		# Hashed filenames, so a changed file is a new URL.
		@assets path /_astro/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
	}
	# Error responses skip the site's header directives, so they import them again.
	handle_errors {
		import security
		rewrite * /404.html
		file_server
	}
}
