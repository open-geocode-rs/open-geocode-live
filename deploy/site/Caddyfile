# The site as static files on loopback; public only through the cloudflared tunnel.
# Install as /etc/caddy/Caddyfile, then `sudo systemctl reload caddy`.
{
	auto_https off
	admin localhost:2019
	log {
		format filter {
			wrap json
			fields {
				request>headers delete
				request>remote_ip delete
				request>client_ip delete
				request>uri delete
			}
		}
	}
}

# Crawlers ignore these; robots.txt and the sitemap govern indexing.
(security) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Any host, not 127.0.0.1: tunnel requests carry the public hostname, and a site
# address that doesn't match it answers with an empty 200.
http://:8081 {
	bind 127.0.0.1
	root * /var/www/open-geocode-site
	encode zstd gzip
	import security

	@lookups {
		method GET
		path /api/autocomplete /api/geocode /api/places /api/reverse /api/search /api/try/geocode /api/try/places /api/try/reverse
	}
	handle @lookups {
		reverse_proxy 127.0.0.1:8089 {
			header_up X-Og-Demo-IP {http.request.header.CF-Connecting-IP}
			transport http {
				response_header_timeout 9s
			}
		}
	}

	handle /api/* {
		respond 404
	}

	# /search became /geocode and /places in the engine; keep old links working.
	redir /docs/api/operations/search/ /docs/api/operations/geocode/ permanent
	redir /docs/api/operations/search.md /docs/api/operations/geocode.md permanent

	@installer path /install /install.ps1
	header @installer Content-Type "text/plain; charset=utf-8"

	handle {
		try_files {path} {path}/index.html {path}.html
		file_server
		# Hashed filenames, so a changed file is a new URL.
		@assets path /_astro/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
	}
	# Error responses skip the site's header directives, so they import them again.
	handle_errors {
		import security
		rewrite * /404.html
		file_server
	}
}
